{
  "name": "@dak/canvas-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Vendored Canvas design engine: schema, Yjs document model, script sandbox, inspection, and exporters.",
  "type": "module",
  "exports": {
    "./upstream/*": "./upstream/*"
  },
  "scripts": {
    "prepare": "node ./scripts/place-canvaskit.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "canvaskit-wasm": "0.40.0",
    "fflate": "0.8.3",
    "lucide": "1.31.0",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "quickjs-emscripten": "0.32.0",
    "svgpath": "2.6.0",
    "vue": "3.5.18",
    "yjs": "13.6.30"
  },
  "dak": {
    "vendored": {
      "upstream": "https://github.com/penkrahq/penkra-apps",
      "path": "canvas",
      "license": "MIT",
      "sync": "node scripts/canvas-vendor.ts sync --source <path-to-penkra-apps-checkout>",
      "check": "node scripts/canvas-vendor.ts check"
    }
  }
}
