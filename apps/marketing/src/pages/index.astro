---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
import { GITHUB_REPOSITORY_URL, MARKETING_STATS } from "../lib/site";
import dakApp from "../assets/dak-app.png";

const providers = [
  { name: "Codex", by: "OpenAI" },
  { name: "Claude Code", by: "Anthropic" },
  { name: "Cursor", by: "Anysphere" },
  { name: "Grok", by: "xAI" },
  { name: "OpenCode", by: "Open source" },
  { name: "Antigravity", by: "Google" },
];

const panes = [
  {
    id: "threads",
    title: "Threads",
    body: "One list, every agent. Codex can be refactoring while Claude reviews and Grok reads a thread you left overnight. Switch between them without switching apps.",
  },
  {
    id: "canvas",
    title: "Canvas",
    body: "A surface inside the same window. Draw the shape you want, then hand the frame to a thread and let an agent build it.",
  },
  {
    id: "review",
    title: "Review",
    body: "Every turn ends in a checkpoint: a hidden git ref. Read the diff, keep the change, or restore the branch and go again.",
  },
];
---

<Layout pageClass="page--app">
  <div class="app">
    <!-- macOS window chrome -->
    <header class="titlebar">
      <div class="lights" aria-hidden="true">
        <span class="light light--close"></span>
        <span class="light light--min"></span>
        <span class="light light--zoom"></span>
      </div>
      <span class="titlebar-name">DAK</span>
      <div class="titlebar-end">
        <a class="btn btn--sm" href="/download">Get DAK</a>
        <button class="sidebar-toggle" id="sidebar-toggle" type="button" aria-label="Show navigation" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <aside class="sidebar" id="sidebar">
      <label class="search">
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
          <circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M10.4 10.4 L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
        <input type="text" placeholder="Search" aria-label="Search this page" id="side-search" />
      </label>

      <p class="side-label">Favorites</p>
      <nav class="side-list" id="side-list">
        <span class="side-pill" aria-hidden="true"></span>
        <a class="side-item is-active" href="#overview">Overview</a>
        <a class="side-item" href="#agents">Agents</a>
        <a class="side-item" href="#canvas">Canvas</a>
        <a class="side-item" href="#install">Install</a>
        <a class="side-item" href="#proof">Proof</a>
      </nav>

      <div class="side-foot">
        <p class="side-label">Open source</p>
        <a class="side-repo" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">
          View on GitHub
        </a>
      </div>
    </aside>

    <main class="pane">
      <!-- Overview -->
      <section class="hero" id="overview">
        <h2 class="display" data-in>One window for every agent.</h2>
        <p class="lead" data-in style="--d:80ms">
          Bring your own subscriptions. DAK hosts the coding agents you already pay
          for, side by side, with threads, checkpoints and a canvas in the same place.
        </p>
        <div class="actions" data-in style="--d:160ms">
          <a id="download-btn" href={RELEASES_URL} class="btn btn--lg">
            <span id="download-label">Get DAK</span>
          </a>
          <button class="copy" id="copy-btn" type="button">
            <code id="install-cmd">npx dak@latest</code>
            <span class="copy-label" id="copy-label">Copy</span>
          </button>
        </div>

        <figure class="shot" data-in style="--d:240ms">
          <Image
            src={dakApp}
            alt="DAK: a thread with an agent on the left and the design canvas on the right, in one window"
            format="webp"
            quality={84}
            sizes="(max-width: 860px) 94vw, 1180px"
          />
        </figure>
      </section>

      <!-- Agents -->
      <section class="sec" id="agents">
        <h3 class="sec-title" data-in>Runs the agents you already pay for</h3>
        <p class="sec-lead" data-in style="--d:60ms">
          No key to paste, nothing re-billed. Point DAK at the CLIs on your machine
          and they show up as threads.
        </p>
        <ul class="rows" data-in style="--d:120ms">
          {
            providers.map((p) => (
              <li class="row">
                <span class="row-name">{p.name}</span>
                <span class="row-by">{p.by}</span>
                <span class="tick" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="14" height="14">
                    <path d="M3 8.4 L6.4 11.8 L13 5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Canvas -->
      <section class="sec" id="canvas">
        <h3 class="sec-title" data-in>What is in the window</h3>
        <div class="seg" data-seg data-in style="--d:60ms">
          <span class="seg-thumb" aria-hidden="true"></span>
          {
            panes.map((p, i) => (
              <button class="seg-btn" type="button" data-pane={p.id} aria-selected={i === 0 ? "true" : "false"}>
                {p.title}
              </button>
            ))
          }
        </div>
        <div class="pane-body" data-in style="--d:120ms">
          {
            panes.map((p, i) => (
              <p class="pane-text" data-pane-body={p.id} hidden={i !== 0}>
                {p.body}
              </p>
            ))
          }
        </div>
      </section>

      <!-- Install -->
      <section class="sec" id="install">
        <h3 class="sec-title" data-in>One command</h3>
        <div class="term" data-in style="--d:60ms" aria-hidden="true">
          <div class="term-bar">
            <span class="light light--close"></span>
            <span class="light light--min"></span>
            <span class="light light--zoom"></span>
            <span class="term-name">zsh</span>
          </div>
          <p class="term-line">
            <span class="term-prompt">$</span>
            <span id="typed"></span><span class="caret"></span>
          </p>
        </div>
        <ol class="steps" data-in style="--d:120ms">
          <li><b>Install</b><span>The desktop app, or straight from the terminal.</span></li>
          <li><b>Connect</b><span>Point DAK at the agents already on your machine.</span></li>
          <li><b>Work</b><span>Threads, checkpoints and a canvas, reachable from any device.</span></li>
        </ol>
      </section>

      <!-- Proof -->
      <section class="sec" id="proof">
        <div class="stats" data-in>
          <div class="stat">
            <span class="stat-num">{MARKETING_STATS.users}</span>
            <span class="stat-cap">developers</span>
          </div>
          <div class="stat">
            <span class="stat-num">6</span>
            <span class="stat-cap">agents hosted</span>
          </div>
        </div>
      </section>

      <!-- Close -->
      <section class="close">
        <p class="close-line" data-in>
          DAK is free and open source. It hosts the agents you already pay for,
          in one window.
        </p>
        <div class="actions" data-in style="--d:80ms">
          <a id="download-btn-2" href={RELEASES_URL} class="btn btn--lg">
            <span id="download-label-2">Get DAK</span>
          </a>
          <a class="quiet" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">
            {MARKETING_STATS.users} people already use it
          </a>
        </div>
      </section>

      <footer class="foot">
        <span>&copy; {new Date().getFullYear()} DAK</span>
        <span class="foot-links">
          <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">GitHub</a>
          <a href="/download">Download</a>
          <a href="/legal">Legal</a>
        </span>
      </footer>
    </main>
  </div>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, type ReleaseAsset } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Get DAK for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Get DAK for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Get DAK for Linux" };
    return null;
  }

  // Macs always get the arm64 build. Browsers cannot reliably tell Apple Silicon
  // from Intel (the UA lies, GPU strings lie), and a wrong guess hands an Apple
  // Silicon user a broken app. Intel users pick their build on /download.
  // Do NOT add arch detection back here.
  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((a) => a.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      return assets.find((a) => a.name.endsWith("-arm64.dmg"))?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((a) => a.name.endsWith("-x86_64.AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  async function initDownload() {
    const platform = detectPlatform();
    if (!platform) return;
    document.documentElement.dataset.platform = platform.os;
    for (const [btnId, labelId] of [
      ["download-btn", "download-label"],
      ["download-btn-2", "download-label-2"],
    ] as const) {
      const btn = document.getElementById(btnId) as HTMLAnchorElement | null;
      const label = document.getElementById(labelId);
      if (label) label.textContent = platform.label;
      if (!btn) continue;
      try {
        const release = await fetchLatestRelease();
        const url = pickAsset(release.assets ?? [], platform);
        if (url) {
          btn.href = url;
          btn.removeAttribute("target");
          btn.removeAttribute("rel");
        }
      } catch {
        btn.href = RELEASES_URL;
      }
    }
  }
  initDownload();

  // Copy the install command.
  const copyBtn = document.getElementById("copy-btn");
  const cmdEl = document.getElementById("install-cmd");
  const copyLabel = document.getElementById("copy-label");
  if (copyBtn && cmdEl && copyLabel) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(cmdEl.textContent?.trim() ?? "npx dak@latest");
        copyLabel.textContent = "Copied";
      } catch {
        copyLabel.textContent = "Press Cmd+C";
      }
      setTimeout(() => {
        copyLabel.textContent = "Copy";
      }, 1600);
    });
  }

  // Sections enter once, on the way in.
  const rising = document.querySelectorAll("[data-in]");
  if (rising.length > 0 && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
    );
    rising.forEach((el) => io.observe(el));
  } else {
    rising.forEach((el) => el.classList.add("is-in"));
  }

  // The sidebar pill tracks the section you are reading.
  const list = document.getElementById("side-list");
  const pill = list?.querySelector<HTMLElement>(".side-pill");
  const items = list ? Array.from(list.querySelectorAll<HTMLAnchorElement>(".side-item")) : [];
  const movePill = (item: HTMLElement) => {
    if (!pill) return;
    pill.style.height = `${item.offsetHeight}px`;
    pill.style.transform = `translateY(${item.offsetTop}px)`;
  };
  if (items.length > 0) {
    const setActive = (id: string) => {
      items.forEach((item) => {
        const on = item.getAttribute("href") === `#${id}`;
        item.classList.toggle("is-active", on);
        if (on) movePill(item);
      });
    };
    const sections = items
      .map((i) => document.querySelector<HTMLElement>(i.getAttribute("href") ?? ""))
      .filter((s): s is HTMLElement => Boolean(s));
    if ("IntersectionObserver" in window) {
      const spy = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio);
          if (visible[0]?.target.id) setActive(visible[0].target.id);
        },
        { rootMargin: "-25% 0px -55% 0px", threshold: [0.01, 0.25, 0.6] }
      );
      sections.forEach((s) => spy.observe(s));
    }
    requestAnimationFrame(() => movePill(items[0]));
    window.addEventListener("resize", () => {
      const active = items.find((i) => i.classList.contains("is-active"));
      if (active) movePill(active);
    });
  }

  // The segmented control slides its thumb and swaps the pane.
  const seg = document.querySelector<HTMLElement>("[data-seg]");
  if (seg) {
    const thumb = seg.querySelector<HTMLElement>(".seg-thumb");
    const buttons = Array.from(seg.querySelectorAll<HTMLButtonElement>(".seg-btn"));
    const bodies = Array.from(document.querySelectorAll<HTMLElement>("[data-pane-body]"));
    const select = (btn: HTMLElement) => {
      buttons.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
      bodies.forEach((b) => {
        b.hidden = b.dataset.paneBody !== btn.dataset.pane;
      });
      if (thumb) {
        thumb.style.width = `${btn.offsetWidth}px`;
        thumb.style.transform = `translateX(${btn.offsetLeft}px)`;
      }
    };
    buttons.forEach((btn) => btn.addEventListener("click", () => select(btn)));
    requestAnimationFrame(() => select(buttons[0]));
    window.addEventListener("resize", () => {
      const active = buttons.find((b) => b.getAttribute("aria-selected") === "true");
      if (active) select(active);
    });
  }

  // The terminal types the install command once, when it comes into view.
  const typed = document.getElementById("typed");
  if (typed) {
    const command = "npx dak@latest";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      typed.textContent = command;
    } else {
      let started = false;
      const run = () => {
        if (started) return;
        started = true;
        let i = 0;
        const step = () => {
          typed.textContent = command.slice(0, ++i);
          if (i < command.length) setTimeout(step, 70);
        };
        setTimeout(step, 260);
      };
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            run();
            io.disconnect();
          }
        });
        const term = document.querySelector(".term");
        if (term) io.observe(term);
      } else {
        run();
      }
    }
  }

  // Narrow screens: the sidebar slides in over the pane.
  const toggle = document.getElementById("sidebar-toggle");
  const sidebar = document.getElementById("sidebar");
  if (toggle && sidebar) {
    const setOpen = (open: boolean) => {
      sidebar.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };
    toggle.addEventListener("click", () => setOpen(!sidebar.classList.contains("is-open")));
    sidebar.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }
</script>

<style>
  :global(.page--app) {
    --desk: #e9e9ee;
    --win: #ffffff;
    --chrome: rgba(248, 248, 250, 0.72);
    --chrome-solid: #f7f7f9;
    --side: rgba(240, 240, 244, 0.66);
    --line: rgba(0, 0, 0, 0.08);
    --line-2: rgba(0, 0, 0, 0.13);
    --ink: #1d1d1f;
    --ink-2: #4a4a51;
    --ink-3: #66666d;
    --blue: #0068e8;
    --blue-deep: #0052c0;
    --ctl-r: 7px;
    --ui: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--desk);
    color: var(--ink);
    font-family: var(--ui);
    position: relative;
  }

  /* A soft wallpaper, barely there, so the translucent chrome has something
     to sit over the way vibrancy does in a real window. */
  :global(.page--app)::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(900px 620px at 12% -8%, rgb(10 132 255 / 9%), transparent 62%),
      radial-gradient(760px 560px at 96% 4%, rgb(255 122 89 / 7%), transparent 60%);
  }

  .app {
    position: relative;
    z-index: 1;
    min-height: 100svh;
  }

  /* ── Title bar ────────────────────────────────────────── */
  .titlebar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 52px;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 16px;
    background: var(--chrome);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border-bottom: 1px solid var(--line);
  }

  .lights {
    display: inline-flex;
    gap: 8px;
    flex: none;
  }

  .light {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 12%);
  }

  .light--close { background: #ff5f57; }
  .light--min { background: #febc2e; }
  .light--zoom { background: #28c840; }

  .titlebar-name {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .titlebar-end {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .sidebar-toggle {
    display: none;
    width: 30px;
    height: 24px;
    border-radius: 6px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 3px;
    transition: background 0.15s ease;
  }

  .sidebar-toggle:hover { background: rgb(0 0 0 / 6%); }

  .sidebar-toggle span {
    display: block;
    width: 14px;
    height: 1.5px;
    border-radius: 1px;
    background: var(--ink-2);
  }

  /* ── Sidebar ──────────────────────────────────────────── */
  .sidebar {
    position: fixed;
    top: 52px;
    bottom: 0;
    left: 0;
    width: 250px;
    z-index: 30;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 12px 16px;
    background: var(--side);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border-right: 1px solid var(--line);
  }

  .search {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 28px;
    padding: 0 9px;
    border-radius: var(--ctl-r);
    background: rgb(255 255 255 / 72%);
    box-shadow: inset 0 0 0 1px var(--line), inset 0 1px 1px rgb(0 0 0 / 4%);
    color: var(--ink-3);
    margin-bottom: 10px;
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    outline: none;
    font: inherit;
    font-size: 13px;
    color: var(--ink);
  }

  .search input::placeholder { color: var(--ink-3); }

  .side-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink-3);
    padding: 0 8px;
    margin-bottom: 2px;
  }

  .side-list {
    position: relative;
    display: grid;
    gap: 1px;
  }

  .side-pill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 28px;
    border-radius: var(--ctl-r);
    background: var(--blue);
    transition: transform 0.34s cubic-bezier(0.32, 0.72, 0, 1), height 0.2s ease;
  }

  .side-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 8px;
    border-radius: var(--ctl-r);
    font-size: 13px;
    color: var(--ink);
    transition: color 0.2s ease, background 0.15s ease;
  }

  .side-item:hover:not(.is-active) { background: rgb(0 0 0 / 5%); }

  .side-item.is-active {
    color: #fff;
    font-weight: 500;
  }

  .side-foot {
    margin-top: auto;
    padding: 12px 8px 0;
  }

  .side-foot .side-label { padding: 0; margin-bottom: 4px; }

  .side-repo {
    font-size: 13px;
    color: var(--ink-2);
    transition: color 0.15s ease;
  }

  .side-repo:hover { color: var(--blue); }

  /* ── Pane ─────────────────────────────────────────────── */
  .pane {
    margin: 52px 0 0 250px;
    padding: 0 clamp(24px, 5vw, 72px);
    max-width: 1200px;
  }

  .display {
    font-family: var(--font-sans);
    font-size: clamp(40px, 5.2vw, 72px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.94;
    max-width: 14ch;
    margin-top: 96px;
  }

  .lead {
    margin-top: 22px;
    max-width: 52ch;
    font-size: 20px;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    padding: 0 16px;
    border-radius: var(--ctl-r);
    background: var(--blue);
    color: #fff;
    font-family: var(--ui);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    transition: background 0.16s ease, transform 0.16s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .btn:hover { background: var(--blue-deep); }
  .btn:active { transform: scale(0.975); }

  .btn--lg { height: 40px; padding: 0 20px; }

  .copy {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line-2);
    border-radius: var(--ctl-r);
    background: rgb(255 255 255 / 78%);
    transition: background 0.16s ease, transform 0.16s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .copy:hover { background: #fff; }
  .copy:active { transform: scale(0.985); }

  .copy code {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink);
  }

  .copy-label {
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-3);
  }

  /* ── The one image ────────────────────────────────────── */
  .shot {
    margin: 56px 0 0;
    border-radius: 12px;
    background: #101012;
    padding: 6px;
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 16%),
