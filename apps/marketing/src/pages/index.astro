---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
import { GITHUB_REPOSITORY_URL, MARKETING_STATS } from "../lib/site";
import dakApp from "../assets/dak-app.png";

const providers = [
  { name: "Codex", by: "OpenAI" },
  { name: "Claude Code", by: "Anthropic" },
  { name: "Cursor", by: "Anysphere" },
  { name: "Grok", by: "xAI" },
  { name: "OpenCode", by: "Open source" },
  { name: "Antigravity", by: "Google" },
];

const panes = [
  {
    id: "threads",
    title: "Threads",
    body: "One list, every agent. Codex can be refactoring while Claude reviews and Grok reads a thread you left overnight. Switch between them without switching apps.",
  },
  {
    id: "canvas",
    title: "Canvas",
    body: "A surface inside the same window. Draw the shape you want, then hand the frame to a thread and let an agent build it.",
  },
  {
    id: "review",
    title: "Review",
    body: "Every turn ends in a checkpoint: a hidden git ref. Read the diff, keep the change, or restore the branch and go again.",
  },
];
---

<Layout pageClass="page--app">
  <div class="app">
    <!-- macOS window chrome -->
    <header class="topbar">
      <span class="topbar-name">DAK</span>
      <nav class="topnav" aria-label="Sections">
        <a class="topnav-link is-active" href="#overview">Overview</a>
        <a class="topnav-link" href="#agents">Agents</a>
        <a class="topnav-link" href="#canvas">Canvas</a>
        <a class="topnav-link" href="#install">Install</a>
      </nav>
      <a class="btn btn--sm" href="/download">Get DAK</a>
    </header>

    <main class="pane">
      <!-- Overview -->
      <section class="hero" id="overview">
        <h2 class="display" data-in>One window for every agent.</h2>
        <p class="lead" data-in style="--d:80ms">
          Bring your own subscriptions. DAK hosts the coding agents you already pay
          for, side by side, with threads, checkpoints and a canvas in the same place.
        </p>
        <div class="actions" data-in style="--d:160ms">
          <a id="download-btn" href={RELEASES_URL} class="btn btn--lg">
            <span id="download-label">Get DAK</span>
          </a>
          <button class="copy" id="copy-btn" type="button">
            <code id="install-cmd">npx dak@latest</code>
            <span class="copy-label" id="copy-label">Copy</span>
          </button>
        </div>

        <div class="run" data-in style="--d:220ms" aria-hidden="true">
          <div class="run-head">
            <span class="run-dot"></span>
            <span class="run-title">Working</span>
            <span class="run-count" id="run-count">1 of 4</span>
          </div>
          <ol class="run-steps" id="run-steps">
            <li>Read the repo</li>
            <li>Plan the change</li>
            <li>Edit files</li>
            <li>Capture checkpoint</li>
          </ol>
        </div>

        <figure class="shot" data-in style="--d:240ms">
          <Image
            src={dakApp}
            alt="DAK: a thread with an agent on the left and the design canvas on the right, in one window"
            format="webp"
            quality={84}
            sizes="(max-width: 860px) 94vw, 1180px"
          />
        </figure>
      </section>

      <!-- Agents -->
      <section class="sec" id="agents">
        <h3 class="sec-title" data-in>Runs the agents you already pay for</h3>
        <p class="sec-lead" data-in style="--d:60ms">
          No key to paste, nothing re-billed. Point DAK at the CLIs on your machine
          and they show up as threads.
        </p>
        <ul class="rows" data-in style="--d:120ms">
          {
            providers.map((p) => (
              <li class="row">
                <span class="row-name">{p.name}</span>
                <span class="row-by">{p.by}</span>
                <span class="tick" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="14" height="14">
                    <path d="M3 8.4 L6.4 11.8 L13 5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Canvas -->
      <section class="sec" id="canvas">
        <h3 class="sec-title" data-in>What is in the window</h3>
        <div class="seg" data-seg data-in style="--d:60ms">
          <span class="seg-thumb" aria-hidden="true"></span>
          {
            panes.map((p, i) => (
              <button class="seg-btn" type="button" data-pane={p.id} aria-selected={i === 0 ? "true" : "false"}>
                {p.title}
              </button>
            ))
          }
        </div>
        <div class="pane-body" data-in style="--d:120ms">
          {
            panes.map((p, i) => (
              <p class="pane-text" data-pane-body={p.id} hidden={i !== 0}>
                {p.body}
              </p>
            ))
          }
        </div>
      </section>

      <!-- Install -->
      <section class="sec" id="install">
        <h3 class="sec-title" data-in>One command</h3>
        <div class="term" data-in style="--d:60ms" aria-hidden="true">
          <div class="term-bar">
            <span class="term-name">install</span>
          </div>
          <p class="term-line">
            <span class="term-prompt">$</span>
            <span id="typed"></span><span class="caret"></span>
          </p>
        </div>
        <ol class="steps" data-in style="--d:120ms">
          <li><b>Install</b><span>The desktop app, or straight from the terminal.</span></li>
          <li><b>Connect</b><span>Point DAK at the agents already on your machine.</span></li>
          <li><b>Work</b><span>Threads, checkpoints and a canvas, reachable from any device.</span></li>
        </ol>
      </section>

      <!-- Close -->
      <section class="close">
        <p class="close-line" data-in>
          DAK is free and open source. It hosts the agents you already pay for,
          in one window.
        </p>
        <div class="actions" data-in style="--d:80ms">
          <a id="download-btn-2" href={RELEASES_URL} class="btn btn--lg">
            <span id="download-label-2">Get DAK</span>
          </a>
          <a class="quiet" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">
            {MARKETING_STATS.users} people already use it
          </a>
        </div>
      </section>

      <footer class="foot">
        <span>&copy; {new Date().getFullYear()} DAK</span>
        <span class="foot-links">
          <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">GitHub</a>
          <a href="/download">Download</a>
          <a href="/legal">Legal</a>
        </span>
      </footer>
    </main>
  </div>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, type ReleaseAsset } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Get DAK for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Get DAK for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Get DAK for Linux" };
    return null;
  }

  // Macs always get the arm64 build. Browsers cannot reliably tell Apple Silicon
  // from Intel (the UA lies, GPU strings lie), and a wrong guess hands an Apple
  // Silicon user a broken app. Intel users pick their build on /download.
  // Do NOT add arch detection back here.
  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((a) => a.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      return assets.find((a) => a.name.endsWith("-arm64.dmg"))?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((a) => a.name.endsWith("-x86_64.AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  async function initDownload() {
    const platform = detectPlatform();
    if (!platform) return;
    document.documentElement.dataset.platform = platform.os;
    for (const [btnId, labelId] of [
      ["download-btn", "download-label"],
      ["download-btn-2", "download-label-2"],
    ] as const) {
      const btn = document.getElementById(btnId) as HTMLAnchorElement | null;
      const label = document.getElementById(labelId);
      if (label) label.textContent = platform.label;
      if (!btn) continue;
      try {
        const release = await fetchLatestRelease();
        const url = pickAsset(release.assets ?? [], platform);
        if (url) {
          btn.href = url;
          btn.removeAttribute("target");
          btn.removeAttribute("rel");
        }
      } catch {
        btn.href = RELEASES_URL;
      }
    }
  }
  initDownload();

  // Copy the install command.
  const copyBtn = document.getElementById("copy-btn");
  const cmdEl = document.getElementById("install-cmd");
  const copyLabel = document.getElementById("copy-label");
  if (copyBtn && cmdEl && copyLabel) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(cmdEl.textContent?.trim() ?? "npx dak@latest");
        copyLabel.textContent = "Copied";
      } catch {
        copyLabel.textContent = "Press Cmd+C";
      }
      setTimeout(() => {
        copyLabel.textContent = "Copy";
      }, 1600);
    });
  }

  // Sections enter once, on the way in.
  const rising = document.querySelectorAll("[data-in]");
  if (rising.length > 0 && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
    );
    rising.forEach((el) => io.observe(el));
  } else {
    rising.forEach((el) => el.classList.add("is-in"));
  }

  // The top nav marks the section you are reading.
  const items = Array.from(document.querySelectorAll<HTMLAnchorElement>(".topnav-link"));
  if (items.length > 0 && "IntersectionObserver" in window) {
    const setActive = (id: string) => {
      items.forEach((item) =>
        item.classList.toggle("is-active", item.getAttribute("href") === `#${id}`)
      );
    };
    const sections = items
      .map((i) => document.querySelector<HTMLElement>(i.getAttribute("href") ?? ""))
      .filter((s): s is HTMLElement => Boolean(s));
    const spy = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible[0]?.target.id) setActive(visible[0].target.id);
      },
      { rootMargin: "-25% 0px -55% 0px", threshold: [0.01, 0.25, 0.6] }
    );
    sections.forEach((s) => spy.observe(s));
  }

  // The segmented control slides its thumb and swaps the pane.
  const seg = document.querySelector<HTMLElement>("[data-seg]");
  if (seg) {
    const thumb = seg.querySelector<HTMLElement>(".seg-thumb");
    const buttons = Array.from(seg.querySelectorAll<HTMLButtonElement>(".seg-btn"));
    const bodies = Array.from(document.querySelectorAll<HTMLElement>("[data-pane-body]"));
    const select = (btn: HTMLElement) => {
      buttons.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
      bodies.forEach((b) => {
        b.hidden = b.dataset.paneBody !== btn.dataset.pane;
      });
      if (thumb) {
        thumb.style.width = `${btn.offsetWidth}px`;
        thumb.style.transform = `translateX(${btn.offsetLeft}px)`;
      }
    };
    buttons.forEach((btn) => btn.addEventListener("click", () => select(btn)));
    requestAnimationFrame(() => select(buttons[0]));
    window.addEventListener("resize", () => {
      const active = buttons.find((b) => b.getAttribute("aria-selected") === "true");
      if (active) select(active);
    });
  }

  // The run panel walks a turn step by step. It is the one thing on the page
  // that moves unprompted, so the product reads as working, not as a brochure.
  const runSteps = document.getElementById("run-steps");
  const runCount = document.getElementById("run-count");
  if (runSteps && runCount && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const steps = Array.from(runSteps.querySelectorAll("li"));
    let at = 0;
    const paint = () => {
      steps.forEach((li, i) => {
        li.classList.toggle("is-done", i < at);
        li.classList.toggle("is-active", i === at);
      });
      runCount.textContent = `${at + 1} of ${steps.length}`;
    };
    paint();
    setInterval(() => {
      at = (at + 1) % steps.length;
      paint();
    }, 2400);
  }

  // The terminal types the install command once, when it comes into view.
  const typed = document.getElementById("typed");
  if (typed) {
    const command = "npx dak@latest";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      typed.textContent = command;
    } else {
      let started = false;
      const run = () => {
        if (started) return;
        started = true;
        let i = 0;
        const step = () => {
          typed.textContent = command.slice(0, ++i);
          if (i < command.length) setTimeout(step, 70);
        };
        setTimeout(step, 260);
      };
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            run();
            io.disconnect();
          }
        });
        const term = document.querySelector(".term");
        if (term) io.observe(term);
      } else {
        run();
      }
    }
  }
</script>

<style>
  :global(.page--app) {
    --desk: #e6ebf2;
    --pane: #f4f7fb;
    --card: #ffffff;
    --chrome: rgba(244, 247, 251, 0.82);
    --line: rgba(21, 32, 51, 0.09);
    --line-2: rgba(21, 32, 51, 0.15);
    --ink: #141922;
    --ink-2: #454d5c;
    --ink-3: #5c6675;
    --blue: #0b63d6;
    --blue-deep: #084da8;
    --ctl-r: 7px;
    --ui: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--desk);
    color: var(--ink);
    font-family: var(--ui);
    position: relative;
  }

  /* One cool wash, no second accent. It gives the translucent bar something
     to sit on without turning the page into a gradient. */
  :global(.page--app)::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(1100px 700px at 18% -12%, rgb(11 99 214 / 10%), transparent 66%);
  }

  .app {
    position: relative;
    z-index: 1;
    min-height: 100svh;
  }

  /* ── Top bar ──────────────────────────────────────────── */
  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 54px;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 0 clamp(16px, 4vw, 40px);
    background: var(--chrome);
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    border-bottom: 1px solid var(--line);
  }

  .topbar-name {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .topnav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-right: auto;
  }

  .topnav-link {
    padding: 6px 11px;
    border-radius: var(--ctl-r);
    font-size: 13px;
    color: var(--ink-2);
    transition: color 0.18s ease, background 0.18s ease;
  }

  .topnav-link:hover { background: rgb(11 99 214 / 8%); color: var(--ink); }

  .topnav-link.is-active {
    background: rgb(11 99 214 / 12%);
    color: var(--blue);
    font-weight: 500;
  }

  /* ── Pane ─────────────────────────────────────────────── */
  .pane {
    margin: 54px 0 0;
    padding: 0 clamp(20px, 5vw, 64px);
    max-width: 1160px;
  }

  .display {
    font-family: var(--font-sans);
    font-size: clamp(40px, 5.2vw, 72px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.94;
    max-width: 14ch;
    margin-top: 96px;
  }

  .lead {
    margin-top: 22px;
    max-width: 52ch;
    font-size: 20px;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    padding: 0 16px;
    border-radius: var(--ctl-r);
    background: var(--blue);
    color: #fff;
    font-family: var(--ui);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    transition: background 0.16s ease, transform 0.16s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .btn:hover { background: var(--blue-deep); }
  .btn:active { transform: scale(0.975); }

  .btn--lg { height: 40px; padding: 0 20px; }

  .copy {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line-2);
    border-radius: var(--ctl-r);
    background: rgb(255 255 255 / 78%);
    transition: background 0.16s ease, transform 0.16s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .copy:hover { background: #fff; }
  .copy:active { transform: scale(0.985); }

  .copy code {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink);
  }

  .copy-label {
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-3);
  }

  /* The run panel is the only thing on the page that moves unprompted. It
     walks a real turn so the product reads as working, not as a brochure. */
  .run {
    margin-top: 26px;
    max-width: 420px;
    padding: 14px 16px 15px;
    border-radius: 10px;
    background: var(--pane);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .run-head {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 11px;
  }

  .run-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue);
    flex: none;
    animation: run-pulse 1.6s ease-in-out infinite;
  }

  .run-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }

  .run-count {
    margin-left: auto;
    font-size: 11px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .run-steps {
    list-style: none;
    display: grid;
    gap: 7px;
  }

  .run-steps li {
    position: relative;
    padding-left: 20px;
    font-size: 13px;
    color: var(--ink-3);
    transition: color 0.4s ease;
  }

  .run-steps li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 5px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--line-2);
    transition: box-shadow 0.4s ease, background 0.4s ease;
  }

  .run-steps li.is-done {
    color: var(--ink-2);
  }

  .run-steps li.is-done::before {
    background: var(--ink-3);
    box-shadow: inset 0 0 0 1.5px var(--ink-3);
  }

  .run-steps li.is-active {
    color: var(--ink);
    font-weight: 500;
  }

  .run-steps li.is-active::before {
    background: var(--blue);
    box-shadow: inset 0 0 0 1.5px var(--blue);
  }

  @keyframes run-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.72); }
  }

  /* ── The one image ────────────────────────────────────── */
  .shot {
    margin: 56px 0 0;
    border-radius: 12px;
    background: #101012;
    padding: 6px;
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 16%),
      0 1px 2px rgb(0 0 0 / 8%),
      0 24px 60px -18px rgb(0 0 0 / 34%);
  }

  .shot > :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  /* ── Sections ─────────────────────────────────────────── */
  .sec {
    padding: 88px 0 0;
    scroll-margin-top: 72px;
  }

  .sec-title {
    font-family: var(--font-sans);
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
    max-width: 20ch;
  }

  .sec-lead {
    margin-top: 12px;
    max-width: 52ch;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .rows {
    margin-top: 26px;
    list-style: none;
    max-width: 620px;
    background: var(--card);
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--line), 0 1px 2px rgb(0 0 0 / 5%);
    overflow: hidden;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    transition: background 0.14s ease;
  }

  .row:hover { background: rgb(0 0 0 / 2.5%); }

  .row + .row { box-shadow: inset 0 1px 0 var(--line); }

  .row-name { font-size: 16px; font-weight: 500; letter-spacing: -0.01em; }

  .row-by { font-size: 13px; color: var(--ink-3); margin-left: auto; }

  .tick {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    flex: none;
  }

  /* ── Segmented control ────────────────────────────────── */
  .seg {
    position: relative;
    display: inline-flex;
    gap: 2px;
    margin-top: 22px;
    padding: 2px;
    border-radius: 9px;
    background: rgb(0 0 0 / 6%);
  }

  .seg-thumb {
    position: absolute;
    top: 2px;
    left: 0;
    height: calc(100% - 4px);
    border-radius: 7px;
    background: var(--card);
    box-shadow: 0 1px 2px rgb(0 0 0 / 14%), inset 0 0 0 0.5px rgb(0 0 0 / 5%);
    transition: transform 0.34s cubic-bezier(0.32, 0.72, 0, 1), width 0.34s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .seg-btn {
    position: relative;
    z-index: 1;
    height: 28px;
    padding: 0 16px;
    border-radius: 7px;
    font-family: var(--ui);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
