---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
import { GITHUB_REPOSITORY_URL, MARKETING_STATS } from "../lib/site";
import appWindow from "../assets/app-window.png";
import canvasFull from "../assets/canvas-full.png";
import rackFragment from "../assets/fragments/rack.png";
import envPanel from "../assets/fragments/env-panel.png";
import composerFragment from "../assets/fragments/composer.png";
import reviewFragment from "../assets/fragments/review.png";
import canvasFrames from "../assets/fragments/canvas-frames.png";

const marks = [
  { name: "Codex", src: "/harnesses/openai_dark.svg" },
  { name: "Claude Code", src: "/harnesses/claude-ai-icon.svg" },
  { name: "Cursor", src: "/harnesses/cursor_light.svg" },
  { name: "Grok", src: "/harnesses/grok-dark.svg" },
  { name: "OpenCode", src: "/harnesses/opencode-dark.svg" },
  { name: "Antigravity", src: "/harnesses/antigravity.svg" },
];

const threads = [
  { badge: "DA", name: "DAK", task: "Do a revamp of the marketing site", age: "8m", mark: "/harnesses/opencode-dark.svg", markName: "OpenCode", where: "main", note: "Checkpoint captured. +13 -7 on fix/webpack-build-hostinger." },
  { badge: "ke", name: "keldra", task: "Do a code review on my changes in the cart", age: "55m", mark: "/harnesses/claude-ai-icon.svg", markName: "Claude Code", where: "main", note: "Four files touched, two suggestions left unresolved." },
  { badge: "EH", name: "EllysHouse-shop", task: "Before users pay for an order they can see the total", age: "11h", mark: "/harnesses/openai_dark.svg", markName: "Codex", where: "main", note: "Re-quote runs before confirmPayment. Residual race window flagged." },
  { badge: "DA", name: "DAK", task: "Replicate the design visually in the canvas", age: "20h", mark: "/harnesses/opencode-dark.svg", markName: "OpenCode", where: "main", note: "Six frames drawn on the canvas, ready to hand to an agent." },
  { badge: "po", name: "portfolio", task: "hello", age: "22h", mark: "/harnesses/cursor_light.svg", markName: "Cursor", where: "main", note: "Idle. No checkpoint pending." },
  { badge: "ke", name: "keldra", task: "Wire the Windows sidecar into the release archive", age: "1d", mark: "/harnesses/grok-dark.svg", markName: "Grok", where: "fix/sidecar", note: "Build green. Ready to restore or keep." },
  { badge: "EH", name: "EllysHouse-shop", task: "Bring the product grid onto the new tokens", age: "2d", mark: "/harnesses/antigravity.svg", markName: "Antigravity", where: "feat/tokens", note: "Stopped at a checkpoint so you can read the diff." },
];
---

<Layout>
  <!-- Hero. The sentence is split and pushed to the edges; the product sits in
       the gap and advances on scroll, one real window at a time. -->
  <section class="hero">
    <h1 class="hero-line" data-rise>
      <span class="hero-half">One window</span>
      <span class="hero-half hero-half--right">for every agent</span>
    </h1>

    <div class="reel" data-reel>
      <div class="reel-sticky">
        <div class="reel-viewport" data-ui aria-label="The DAK window: a thread with an agent, a canvas, and the project rack">
          <div class="reel-track" data-reel-track>
            <figure class="reel-frame reel-frame--lead">
              <Image
                src={appWindow}
                alt="DAK showing a code review thread beside its environment panel"
                format="webp"
                quality={82}
                sizes="(max-width: 760px) 92vw, 1080px"
              />
            </figure>
            <figure class="reel-frame">
              <Image
                src={canvasFull}
                alt="The DAK canvas with six mobile screens drawn on it"
                format="webp"
                quality={82}
                sizes="(max-width: 760px) 92vw, 1080px"
              />
            </figure>
            <figure class="reel-frame reel-frame--pair">
              <Image
                src={rackFragment}
                alt="The thread rack, one row per agent"
                format="webp"
                quality={85}
              />
              <Image
                src={envPanel}
                alt="The environment panel showing branch, sync ref and changes"
                format="webp"
                quality={85}
              />
            </figure>
          </div>
        </div>
        <p class="reel-caption" data-reel-caption>
          <span data-caption>A thread with an agent, and the environment it runs in.</span>
        </p>
      </div>
    </div>

    <div class="hero-foot" data-rise style="--d:200ms">
      <p class="hero-support">
        Bring your own subscriptions. DAK hosts the coding agents you already pay for.
      </p>
      <div class="hero-action">
        <a id="download-btn" href={RELEASES_URL} class="btn btn-primary btn-lg">
          <span id="download-label">Get DAK</span>
        </a>
        <a class="hero-alt-link" href="/download">All platforms</a>
      </div>
    </div>
  </section>

  <!-- The rack. The product's signature, and the one thing here you can press:
       every row is a thread, and the open one is the working one. -->
  <section class="rack" id="rack">
    <div class="rack-inner">
      <p class="rack-lead" data-in>
        Every agent gets its own thread. All of them live in the same list.
      </p>

      <div class="board" data-board data-in>
        {
          threads.map((t, i) => (
            <button class="row" data-open={i === 0 ? "" : undefined} aria-expanded={i === 0 ? "true" : "false"}>
              <span class="row-id">
                <span class="row-badge">{t.badge}</span>
                <span class="row-name">{t.name}</span>
              </span>
              <span class="row-task">{t.task}</span>
              <img class="row-mark" src={t.mark} alt={t.markName} width="20" height="20" />
              <span class="row-age">{t.age}</span>
              <span class="row-detail">
                <span>
                  {t.where} · {t.note}
                </span>
                <span>Open the diff, keep what you like, restore the rest.</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What is inside. A single-column run of rows, each a statement beside the
       real fragment that proves it. The fragments differ in shape on purpose. -->
  <section class="caps" id="capabilities">
    <div class="caps-inner">
      <article class="cap cap--lead">
        <div class="cap-text" data-in>
          <h2 class="cap-title">Ask in plain language</h2>
          <p class="cap-body">
            Tag a file, pull in a skill, or drop to a slash command without leaving
            the box you type in. The agent picks up the rest.
          </p>
        </div>
        <figure class="cap-media cap-media--full" data-ui data-in style="--d:100ms">
          <Image
            src={composerFragment}
            alt="The DAK composer, with its model, permission and access pickers"
            format="webp"
            quality={88}
            sizes="(max-width: 900px) 92vw, 1144px"
          />
        </figure>
      </article>

      <article class="cap">
        <div class="cap-text" data-in>
          <h2 class="cap-title">A canvas to design on</h2>
          <p class="cap-body">
            Sketch, wireframe and mock inside the same window your agent is working in.
            Hand the frames straight to a thread when they are ready.
          </p>
        </div>
        <figure class="cap-media cap-media--wide" data-ui data-in style="--d:100ms">
          <Image
            src={canvasFrames}
            alt="Six mobile screens laid out on the DAK canvas"
            format="webp"
            quality={85}
            sizes="(max-width: 900px) 92vw, 620px"
          />
        </figure>
      </article>

      <article class="cap cap--flip">
        <div class="cap-text" data-in>
          <h2 class="cap-title">It shows its work</h2>
          <p class="cap-body">
            Every turn ends in a checkpoint: a hidden git ref you can diff against.
            Keep the change, or restore the branch and go again.
          </p>
        </div>
        <figure class="cap-media" data-ui data-in style="--d:100ms">
          <Image
            src={reviewFragment}
            alt="An agent's review of a payment fix, with the risks it found"
            format="webp"
            quality={85}
            sizes="(max-width: 900px) 92vw, 620px"
          />
        </figure>
      </article>

      <article class="cap">
        <div class="cap-text" data-in>
          <h2 class="cap-title">The machine it runs on</h2>
          <p class="cap-body">
            Branch, sync ref and the changes a turn actually made, one panel away
            from the conversation that made them.
          </p>
        </div>
        <figure class="cap-media cap-media--tall" data-ui data-in style="--d:100ms">
          <Image
            src={envPanel}
            alt="The environment panel: branch, sync ref and +13 -7 changes"
            format="webp"
            quality={88}
            sizes="(max-width: 900px) 92vw, 362px"
          />
        </figure>
      </article>
    </div>
  </section>

  <!-- Install. One command, then the three things that happen next. -->
  <section class="install" id="install">
    <div class="install-inner" data-in>
      <h2 class="install-title">One command</h2>
      <div class="cmd">
        <code id="install-cmd">npx dak@latest</code>
        <button class="cmd-copy" id="copy-btn" type="button">Copy</button>
      </div>

      <ol class="steps">
        <li>
          <b>Install</b>
          <span>The desktop app, or straight from the terminal.</span>
        </li>
        <li>
          <b>Connect</b>
          <span>Point DAK at the agents you already pay for. Nothing is re-billed, no key to paste.</span>
        </li>
        <li>
          <b>Work</b>
          <span>Threads, checkpoints and a canvas, in one window that also reaches your machine remotely.</span>
        </li>
      </ol>
    </div>
  </section>

  <!-- Proof. The agents it hosts, on the dark stage they belong on. -->
  <section class="agents" id="agents">
    <div class="agents-inner" data-in>
      <div class="agent-tile agent-tile--head">
        <p class="agent-head">Runs the agents you already pay for</p>
        <p class="agent-sub">
          Bring your own subscriptions. Open source, {MARKETING_STATS.githubStars} on GitHub.
        </p>
      </div>
      {
        marks.map((m) => (
          <div class="agent-tile">
            <img class="agent-mark" src={m.src} alt="" width="72" height="72" loading="lazy" />
            <span class="agent-name">{m.name}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Close. One sentence, one action. -->
  <section class="cta">
    <p class="cta-line" data-rise>
      DAK is free and open source. It hosts the agents you already pay for, in one window.
    </p>
    <div class="cta-action" data-rise style="--d:120ms">
      <a id="download-btn-2" href={RELEASES_URL} class="btn btn-primary btn-lg">
        <span id="download-label-2">Get DAK</span>
      </a>
      <a class="cta-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">
        {MARKETING_STATS.users} people already use it
      </a>
    </div>
  </section>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, type ReleaseAsset } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Get DAK for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Get DAK for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Get DAK for Linux" };
    return null;
  }

  // Macs always get the arm64 build. Browsers cannot reliably tell Apple Silicon
  // from Intel (the UA lies, GPU strings lie), and a wrong guess hands an Apple
  // Silicon user a broken app. Intel users pick their build on /download.
  // Do NOT add arch detection back here.
  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((a) => a.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      return assets.find((a) => a.name.endsWith("-arm64.dmg"))?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((a) => a.name.endsWith("-x86_64.AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  async function initDownload() {
    const platform = detectPlatform();
    if (!platform) return;
    document.documentElement.dataset.platform = platform.os;
    for (const [btnId, labelId] of [
      ["download-btn", "download-label"],
      ["download-btn-2", "download-label-2"],
    ] as const) {
      const btn = document.getElementById(btnId) as HTMLAnchorElement | null;
      const label = document.getElementById(labelId);
      if (label) label.textContent = platform.label;
      if (!btn) continue;
      try {
        const release = await fetchLatestRelease();
        const url = pickAsset(release.assets ?? [], platform);
        if (url) {
          btn.href = url;
          btn.removeAttribute("target");
          btn.removeAttribute("rel");
        }
      } catch {
        btn.href = RELEASES_URL;
      }
    }
  }
  initDownload();

  // CTA: copy the install command.
  const copyBtn = document.getElementById("copy-btn");
  const cmdEl = document.getElementById("install-cmd");
  if (copyBtn && cmdEl) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(cmdEl.textContent?.trim() ?? "npx dak@latest");
        copyBtn.textContent = "Copied";
      } catch {
        copyBtn.textContent = "Press Cmd+C";
      }
      setTimeout(() => {
        copyBtn.textContent = "Copy";
      }, 1600);
    });
  }

  // The rack: exactly one row is open, and pressing another moves it.
  const board = document.querySelector("[data-board]");
  if (board) {
    const rows = Array.from(board.querySelectorAll<HTMLButtonElement>(".row"));
    rows.forEach((row) => {
      row.addEventListener("click", () => {
        const already = row.hasAttribute("data-open");
        rows.forEach((other) => {
          other.removeAttribute("data-open");
          other.setAttribute("aria-expanded", "false");
        });
        if (!already) {
          row.setAttribute("data-open", "");
          row.setAttribute("aria-expanded", "true");
        }
      });
    });
  }

  // Sections enter once, on the way in. Nothing here loops, so the GPU stays idle.
  const rising = document.querySelectorAll("[data-in]");
  if (rising.length > 0 && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.08 }
    );
    rising.forEach((el) => io.observe(el));
  } else {
    rising.forEach((el) => el.classList.add("is-in"));
  }

  // The hero reel advances one frame per step of scroll. One rAF per frame,
  // driven by a passive listener, so the page never repaints on its own.
  const reel = document.querySelector("[data-reel]");
  const track = document.querySelector<HTMLElement>("[data-reel-track]");
  const caption = document.querySelector<HTMLElement>("[data-caption]");
  const captions = [
    "A thread with an agent, and the environment it runs in.",
    "The canvas, where a design becomes something you can hand to an agent.",
    "The rack and the panel: what is running, and what it changed.",
  ];
  if (reel && track) {
    const steps = track.children.length - 1;
    let ticking = false;
    const update = () => {
      ticking = false;
      const box = reel.getBoundingClientRect();
      const span = box.height - window.innerHeight;
      if (span <= 0) return;
      const p = Math.min(1, Math.max(0, -box.top / span));
      const at = p * steps;
      track.style.setProperty("--p", at.toFixed(4));
      if (caption) {
        const next = captions[Math.min(captions.length - 1, Math.round(at))];
        if (caption.textContent !== next) caption.textContent = next;
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }
</script>

<style>
  /* Sections enter once. Armed only when JS is on, so nothing is ever hidden
     behind a script that failed to load. */
  :global(.js) [data-in] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms),
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms);
  }

  :global(.js) [data-in].is-in {
    opacity: 1;
    transform: none;
  }

  /* The one moving picture. Transform only, so it composites rather than
     repaints, and it stops entirely under reduced motion. */
  @keyframes drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.035);
    }
  }

  .reel-frame--lead > :global(img) {
    animation: drift 24s ease-in-out infinite alternate;
    transform-origin: 30% 40%;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-in] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .reel-frame--lead > :global(img) {
      animation: none;
    }
  }

  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    --reel-h: min(58svh, 54vw);
    --peek: 48px;
    padding: 64px 0 0;
  }

  .hero-line {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    font-size: clamp(40px, 3.6vw, 60px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.92;
  }

  .hero-half--right {
    text-align: right;
  }

  .reel {
    height: calc(var(--reel-h) + 92svh);
    margin-top: 44px;
  }

  .reel-sticky {
    position: sticky;
    top: 84px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .reel-viewport {
    height: calc(var(--reel-h) + var(--peek) * 2 + 24px);
    overflow: hidden;
  }

  .reel-track {
    display: grid;
    gap: 24px;
    padding-top: var(--peek);
    transform: translateY(calc(var(--p, 0) * (var(--reel-h) + 24px) * -1));
  }

  .reel-frame {
    height: var(--reel-h);
    background: var(--stage);
    border-radius: var(--radius-lg);
    padding: 10px;
    display: grid;
  }

  .reel-frame > :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 6px;
  }

  .reel-frame--pair {
    grid-auto-flow: column;
    align-items: center;
    justify-items: center;
    gap: 40px;
    padding: 28px;
  }

  .reel-frame--pair > :global(img) {
    width: auto;
    height: 100%;
  }

  .reel-caption {
    margin-top: 20px;
    min-height: 1.5em;
    font-size: 17px;
    color: var(--fg-muted);
  }

  .hero-foot {
    max-width: 1240px;
    margin: 0 auto;
    padding: 40px 32px 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .hero-support {
    max-width: 46ch;
    font-size: 17px;
    color: var(--fg);
  }

  .hero-action {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hero-alt-link {
    font-size: 14px;
    color: var(--fg-muted);
    transition: color 0.18s ease;
  }

  .hero-alt-link::after {
    content: " \2192";
  }

  .hero-alt-link:hover {
    color: var(--fg);
  }

  /* ── The rack ─────────────────────────────────────────── */
  .rack {
    margin-top: 96px;
    background: var(--stage);
    color: var(--stage-ink);
    padding: 88px 0 96px;
  }

  .rack-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .rack-lead {
    font-size: 17px;
    color: var(--stage-ink-dim);
    margin-bottom: 28px;
  }

  .board {
    display: grid;
    gap: 4px;
  }

  .row {
    width: 100%;
    min-height: 72px;
    padding: 12px 20px;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 6px 18px;
    text-align: left;
    background: var(--stage-2);
    color: var(--stage-ink);
    transition: background 0.18s ease;
  }

  .row:hover {
    background: #2c2b27;
  }

  .row[data-open] {
    background: var(--accent);
    color: #fff;
  }

  .row-id {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .row-badge {
    flex: none;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    background: rgb(255 255 255 / 12%);
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .row-name {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-task {
    font-size: 17px;
    color: var(--stage-ink-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .row[data-open] .row-task,
  .row[data-open] .row-age {
    color: rgb(255 255 255 / 76%);
  }

  .row-mark {
    width: 20px;
    height: 20px;
    flex: none;
  }

  .row-age {
    font-size: 14px;
    color: var(--stage-ink-dim);
    white-space: nowrap;
  }

  .row-detail {
    grid-column: 1 / -1;
    display: none;
    gap: 6px;
    padding-top: 14px;
    font-size: 17px;
    line-height: 1.5;
    color: rgb(255 255 255 / 82%);
  }

  .row[data-open] .row-detail {
    display: grid;
  }

  /* ── What is inside ───────────────────────────────────── */
  .caps {
    padding: 104px 0;
  }

  .caps-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    gap: 88px;
  }

  .cap {
    display: grid;
    grid-template-columns: 5fr 7fr;
    align-items: center;
    gap: 56px;
  }

  .cap--flip {
    grid-template-columns: 7fr 5fr;
  }

  .cap--flip .cap-text {
    order: 2;
  }

  .cap--lead {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .cap-title {
    font-size: clamp(32px, 3vw, 46px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 16ch;
  }

  .cap-body {
    margin-top: 18px;
    max-width: 42ch;
    font-size: 17px;
    color: var(--fg);
  }

  .cap-media {
    background: var(--stage);
    border-radius: var(--radius-lg);
