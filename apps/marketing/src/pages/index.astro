---
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
import { GITHUB_REPOSITORY_URL, MARKETING_STATS } from "../lib/site";
---

<Layout>
  <!-- Hero: the sentence is the layout. A real product window sits inline on
       the baseline, standing in for the word it replaces. -->
  <section class="hero">
    <h1 class="hero-sentence">
      <span class="hero-word" data-rise>One</span>
      <span class="hero-slot" data-ui data-rise style="--d:80ms" aria-label="The DAK window: a thread with an agent and a composer">
        <span class="slot-inner" data-shutter>
          <span class="win-bar">
            <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="win-title">dak auth-middleware</span>
          </span>
          <span class="win-body">
            <span class="win-row">
              <i class="win-av"></i>
              <span class="win-msg win-msg--user">Rename the auth middleware and run the tests</span>
            </span>
            <span class="win-row">
              <i class="win-av win-av--accent"></i>
              <span class="win-msg">Opening a thread and running the test suite.</span>
            </span>
            <span class="win-row">
              <i class="win-av win-av--accent"></i>
              <span class="win-msg">Done. Checkpoint captured and ready to review.</span>
            </span>
            <span class="win-composer">
              <b class="win-composer-text">Ask anything, press Enter to send</b>
              <span class="win-send" aria-hidden="true"></span>
            </span>
          </span>
        </span>
      </span>
      <span class="hero-word" data-rise style="--d:160ms">for every agent</span>
    </h1>
    <div class="hero-action" data-rise style="--d:320ms">
      <a id="download-btn" href={RELEASES_URL} class="btn btn-primary btn-lg">
        <span id="download-label">Get DAK</span>
      </a>
      <a class="hero-alt-link" href="/download">All platforms</a>
    </div>
    <p class="hero-support" data-rise style="--d:440ms">
      <span>One window for the coding agents you already pay for. Bring your own subscriptions.</span>
    </p>
  </section>

  <!-- Features: a short statement with picture words, then the workbench that
       proves it. Each slot shows the thing the adjacent word names. -->
  <section id="features" class="sec-features">
    <div class="container">
      <p class="statement" data-rise>
        Every agent gets its own
        <span class="inline-slot" data-ui aria-hidden="true">
          <span class="frag frag-thread">
            <span class="frag-thread-line"><i></i><b></b></span>
            <span class="frag-thread-line"><i></i><b></b></span>
          </span>
        </span>
        thread and
        <span class="inline-slot" data-ui aria-hidden="true">
          <span class="frag frag-shell">
            <span class="frag-shell-prompt"></span>
            <span class="frag-shell-bar"></span>
          </span>
        </span>
        shell, a canvas to design on, and diffs to ship.
      </p>
      <div class="workbench" data-ui data-rise style="--d:120ms" role="img" aria-label="One window: a sidebar of agent threads, a design canvas, and a diff ready to ship.">
        <aside class="wb-side">
          <span class="wb-side-item is-active"><i></i><b style="width:64%"></b></span>
          <span class="wb-side-item"><i></i><b style="width:52%"></b></span>
          <span class="wb-side-item"><i></i><b style="width:70%"></b></span>
          <span class="wb-side-item"><i></i><b style="width:44%"></b></span>
        </aside>
        <div class="wb-main">
          <div class="wb-canvas">
            <div class="wb-canvas-frame">
              <span class="wb-block" style="width:38%;height:32%"></span>
              <span class="wb-block wb-block--accent" style="width:24%;height:54%"></span>
              <span class="wb-block wb-block--wide" style="width:56%;height:20%"></span>
            </div>
          </div>
          <div class="wb-diff">
            <span class="wb-diff-line wb-diff-line--add" style="width:78%"></span>
            <span class="wb-diff-line wb-diff-line--del" style="width:52%"></span>
            <span class="wb-diff-line" style="width:64%"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Showcase: the headline is an input. Type in it; the product answers in
       its own interface below. -->
  <section id="showcase" class="sec-showcase">
    <div class="container">
      <input
        id="showcase-input"
        class="showcase-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="Ask DAK to do something"
        aria-label="Type a task for DAK"
        data-rise
      />
      <div class="showcase-answer" data-ui data-rise style="--d:120ms" aria-live="polite">
        <div class="answer-thread">
          <div class="answer-row answer-row--user">
            <span class="answer-role">You</span>
            <span class="answer-text" id="answer-prompt">Ask DAK to do something</span>
          </div>
          <div class="answer-row answer-row--agent">
            <span class="answer-role"><i class="answer-dot"></i>Codex</span>
            <span class="answer-text" id="answer-response">Reading the task, then working it in a thread.</span>
          </div>
          <div class="answer-row answer-row--agent">
            <span class="answer-role"><i class="answer-dot"></i>Codex</span>
            <span class="answer-text">Opening a thread, running the task, then checkpointing.</span>
          </div>
          <div class="answer-row answer-row--agent">
            <span class="answer-role"><i class="answer-dot"></i>Codex</span>
            <span class="answer-text">Editing src/auth/middleware.ts and running the test suite.</span>
          </div>
          <div class="answer-row answer-row--agent">
            <span class="answer-role"><i class="answer-dot"></i>Codex</span>
            <span class="answer-text">Done. Checkpoint captured and ready to review.</span>
          </div>
        </div>
      </div>
      <div class="showcase-examples">
        <button type="button" class="example-chip" data-example="Rename the auth middleware and run the tests">
          Rename the auth middleware
        </button>
        <button type="button" class="example-chip" data-example="Open the pricing page and fix the spacing">
          Fix the pricing spacing
        </button>
        <button type="button" class="example-chip" data-example="Review my last commit and suggest improvements">
          Review my last commit
        </button>
      </div>
    </div>
  </section>

  <!-- How it works: the install command, then the time bar as the diagram.
       Install is a sliver; the work is everything after. -->
  <section id="how" class="sec-how">
    <div class="container">
      <p class="how-statement" data-rise>One command to install, two minutes to connect, then it works all day.</p>
      <div class="terminal" data-ui data-rise style="--d:120ms" role="img" aria-label="A terminal running npx dak@latest, starting the server.">
        <pre class="term-pre"><span class="term-p">$</span> npx dak@latest
<span class="term-ok">server</span> running on localhost:3000
<span class="term-ok">web</span> &middot; <span class="term-ok">desktop</span> &middot; <span class="term-ok">mobile</span> ready
<span class="term-ok">provider</span> codex &middot; connected
<span class="term-ok">workspace</span> ~/projects/app
<span class="term-ok">checkpoint</span> ready to review</pre>
      </div>
      <div class="bar" data-ui role="img" aria-label="Three stages: run one command in a minute, connect a provider in two minutes, then ship all day.">
        <div class="bar-seg bar-seg--install" style="flex-grow: 1">
          <span class="bar-name">npx dak</span>
        </div>
        <div class="bar-seg bar-seg--connect" style="flex-grow: 2">
          <span class="bar-name">Connect a provider</span>
        </div>
        <div class="bar-seg bar-seg--ship" style="flex-grow: 9">
          <span class="bar-name">Ship</span>
        </div>
      </div>
      <div class="bar-legend">
        <span class="bar-dur">One minute</span>
        <span class="bar-dur">Two minutes</span>
        <span class="bar-dur">The rest is yours</span>
      </div>
    </div>
  </section>

  <!-- Proof: the providers are one sentence; one name is lit and cycles. -->
  <section id="proof" class="sec-proof">
    <div class="container">
      <p class="proof-line" data-rise>
        Runs the agents you already pay for:
        <span class="proof-names" id="proof-names">
          <span class="proof-name is-lit">Codex</span><span class="proof-sep">,</span>
          <span class="proof-name">Claude Code</span><span class="proof-sep">,</span>
          <span class="proof-name">Cursor</span><span class="proof-sep">,</span>
          <span class="proof-name">Grok</span><span class="proof-sep">,</span>
          <span class="proof-name">OpenCode</span><span class="proof-sep">,</span>
          <span class="proof-name">Antigravity</span><span class="proof-sep">.</span>
        </span>
      </p>
      <p class="proof-meta">
        Open source. {MARKETING_STATS.githubStars} on GitHub.
      </p>
    </div>
  </section>

  <!-- CTA: a sentence with a blank. The blank holds the command; the last
       word is the button that copies it. -->
  <section id="cta" class="sec-cta">
    <div class="container">
      <p class="cta-sentence" data-rise>
        Open a terminal and run
        <span class="cta-field">
          <code id="install-cmd">npx dak@latest</code>
        </span>
        <button type="button" id="copy-btn" class="btn btn-primary cta-copy">Copy</button>
      </p>
      <p class="cta-note">Or grab the desktop app for macOS, Windows, and Linux.</p>
    </div>
  </section>

  <!-- Footer: the repo link is the headline, on a full field of blueprint. -->
  <footer class="footer-field">
    <a class="footer-headline" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
      github.com/<wbr />ayyesu/DAK
    </a>
    <div class="footer-meta">
      <span class="footer-brand">DAK</span>
      <nav class="footer-links">
        <a href="/download">Download</a>
        <a href="/privacy-policy">Privacy</a>
        <a href="/terms-of-service">Terms</a>
        <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
      <span class="footer-credits">Open source. Bring your own subscriptions.</span>
    </div>
  </footer>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, type ReleaseAsset } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Get DAK for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Get DAK for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Get DAK for Linux" };
    return null;
  }

  // Macs always get the arm64 build. Browsers cannot reliably tell Apple Silicon
  // from Intel (the UA lies, GPU strings lie), and a wrong guess hands an Apple
  // Silicon user a broken app. Intel users pick their build on /download.
  // Do NOT add arch detection back here.
  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((a) => a.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      return assets.find((a) => a.name.endsWith("-arm64.dmg"))?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((a) => a.name.endsWith("-x86_64.AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  async function initDownload() {
    const btn = document.getElementById("download-btn") as HTMLAnchorElement | null;
    const label = document.getElementById("download-label");
    const platform = detectPlatform();
    if (!platform) return;
    document.documentElement.dataset.platform = platform.os;
    if (label) label.textContent = platform.label;
    try {
      const release = await fetchLatestRelease();
      const url = pickAsset(release.assets ?? [], platform);
      if (url && btn) {
        btn.href = url;
        btn.removeAttribute("target");
        btn.removeAttribute("rel");
      }
    } catch {
      if (btn) btn.href = RELEASES_URL;
    }
  }
  initDownload();

  // Showcase: the headline is an input, and the product answers in its own
  // interface. The response names the task back so it feels addressed.
  const input = document.getElementById("showcase-input") as HTMLInputElement | null;
  const promptEl = document.getElementById("answer-prompt");
  const responseEl = document.getElementById("answer-response");
  const fallbackPrompt = "Ask DAK to do something";
  const fallbackResponse = "Reading the task, then working it in a thread.";

  function renderAnswer(value: string) {
    const task = value.trim();
    if (!task) {
      if (promptEl) promptEl.textContent = fallbackPrompt;
      if (responseEl) responseEl.textContent = fallbackResponse;
      return;
    }
    if (promptEl) promptEl.textContent = task;
    if (responseEl) {
      responseEl.textContent = `Opening a thread for "${task}" and starting on it now.`;
    }
  }

  if (input) {
    input.addEventListener("input", () => renderAnswer(input.value));
  }
  document.querySelectorAll<HTMLButtonElement>(".example-chip").forEach((chip) => {
    chip.addEventListener("click", () => {
      const example = chip.dataset.example ?? "";
      if (input) {
        input.value = example;
        input.focus();
      }
      renderAnswer(example);
    });
  });

  // CTA: copy the install command.
  const copyBtn = document.getElementById("copy-btn");
  const cmdEl = document.getElementById("install-cmd");
  if (copyBtn && cmdEl) {
    copyBtn.addEventListener("click", async () => {
      const original = "Copy";
      try {
        await navigator.clipboard.writeText(cmdEl.textContent?.trim() ?? "npx dak@latest");
        copyBtn.textContent = "Copied";
      } catch {
        copyBtn.textContent = "Press Cmd+C";
      }
      setTimeout(() => {
        copyBtn.textContent = original;
      }, 1600);
    });
  }

  // Proof: one name is lit and cycles. The only thing moving in this section.
  const names = Array.from(document.querySelectorAll(".proof-name"));
  if (names.length > 1) {
    let idx = 0;
    setInterval(() => {
      names[idx].classList.remove("is-lit");
      idx = (idx + 1) % names.length;
      names[idx].classList.add("is-lit");
    }, 1400);
  }
</script>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    min-height: 92svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 120px 0 64px;
  }

  .hero-sentence {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.16em 0.28em;
    font-size: clamp(44px, 8vw, 116px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.94;
    padding: 0 32px;
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-word {
    display: inline-block;
    white-space: nowrap;
  }

  /* The media slot is a real product window standing in for a word. data-ui
     marks it a cropped interface fragment, so its 1px frame is exempt. */
  .hero-slot[data-ui] {
    flex: 1 1 auto;
    min-width: min(50vw, 560px);
    min-height: clamp(250px, 24vw, 264px);
    border-radius: 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
  }

  .slot-inner {
    display: flex;
    flex-direction: column;
    width: 100%;
    /* Stretches to the slot's height (which floors at min-height and grows
       with content), so the composer is never clipped at any viewport. */
    /* Shutter reveal: opens vertically once on load. */
    clip-path: inset(50% 0 50% 0);
    animation: shutter-open 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.25s forwards;
  }

  @keyframes shutter-open {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slot-inner {
      animation: none;
      clip-path: none;
    }
  }

  /* Window chrome. Separated by tone, not lines. */
  .win-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: var(--bg-elev);
    flex-shrink: 0;
  }

  .win-dots {
    display: inline-flex;
    gap: 6px;
  }

  .win-dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .win-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--fg-muted);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .win-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(16px, 2.4vw, 26px);
    flex: 1;
  }

  .win-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .win-av {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--fg-faint);
    flex-shrink: 0;
  }

  .win-av--accent {
    background: var(--accent);
  }

  .win-msg {
    font-size: clamp(13px, 1.3vw, 16px);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .win-msg--user {
    color: #4e4c43;
  }

  .win-composer {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding: 12px 14px;
    background: var(--bg-elev);
    border-radius: 8px;
  }

  .win-composer-text {
    font-size: clamp(13px, 1.3vw, 16px);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .win-send {
    margin-left: auto;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 3px;
    background: var(--accent);
    position: relative;
  }

  .win-send::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 8px;
    height: 8px;
    border-top: 2px solid #fff;
    border-right: 2px solid #fff;
    transform: rotate(45deg) translate(-1px, 1px);
  }

  .hero-action {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: clamp(48px, 10vw, 150px);
    padding: 0 32px;
    max-width: 1440px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
  }

  .hero-alt-link {
    font-size: 14px;
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: color 0.18s ease;
  }

  .hero-alt-link:hover {
    color: var(--fg);
  }

  .hero-support {
    padding: 48px 32px 0;
    max-width: 1440px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
  }

  .hero-support > span {
    display: block;
    max-width: 52ch;
    font-size: 22px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  /* ── Shared container ─────────────────────────────────── */
  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ── Features: statement + workbench ──────────────────── */
  .sec-features {
    padding: clamp(72px, 12vw, 160px) 0;
  }

  .statement {
    font-size: clamp(24px, 3.4vw, 36px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.22;
    max-width: 30ch;
    color: var(--fg);
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  /* Picture words: tiny interface fragments inline in the sentence. Filled
     by tone, no frame, so they read as words that happen to be pictures. */
  .inline-slot[data-ui] {
    display: inline-flex;
    align-items: center;
    vertical-align: baseline;
    width: 1.7em;
    height: 0.86em;
    margin: 0 0.1em;
    border-radius: 5px;
    background: var(--bg-card);
    overflow: hidden;
    translate: 0 0.1em;
  }

  .inline-slot .frag {
    width: 100%;
    height: 100%;
  }

  .frag {
    display: block;
  }

  .frag-thread {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.16em;
    padding: 0 0.28em;
  }

  .frag-thread-line {
    display: flex;
    align-items: center;
    gap: 0.16em;
  }

  .frag-thread-line i {
    width: 0.2em;
    height: 0.2em;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .frag-thread-line b {
    height: 0.12em;
    border-radius: 0.06em;
    background: var(--fg-faint);
    flex: 1;
  }

  .frag-shell {
    display: flex;
    align-items: center;
    gap: 0.16em;
    padding: 0 0.28em;
  }

  .frag-shell-prompt {
    width: 0.18em;
    height: 0.18em;
    border-top: 0.14em solid var(--accent);
    border-right: 0.14em solid var(--accent);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .frag-shell-bar {
    height: 0.12em;
    border-radius: 0.06em;
    background: var(--fg-faint);
    flex: 1;
  }

  /* The workbench: one window, four surfaces. A cropped interface fragment. */
  .workbench[data-ui] {
    display: flex;
    gap: 0;
    width: 100%;
    height: clamp(220px, 24vw, 300px);
    border-radius: 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .wb-side {
    width: clamp(120px, 18%, 190px);
    flex-shrink: 0;
    background: var(--bg-elev);
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .wb-side-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 9px;
    border-radius: 5px;
  }

  .wb-side-item.is-active {
    background: var(--bg-card);
  }

  .wb-side-item i {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--fg-faint);
    flex-shrink: 0;
  }

  .wb-side-item.is-active i {
    background: var(--accent);
  }

  .wb-side-item b {
    height: 8px;
    border-radius: 4px;
    background: var(--border);
  }

  .wb-side-item.is-active b {
    background: var(--fg-dim);
  }

  .wb-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .wb-canvas {
    flex: 1;
    padding: clamp(16px, 2.4vw, 28px);
    display: flex;
  }

  .wb-canvas-frame {
    flex: 1;
    border-radius: 8px;
    background: var(--bg-elev);
    position: relative;
    overflow: hidden;
  }

  .wb-block {
    position: absolute;
