---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
import { GITHUB_REPOSITORY_URL, MARKETING_STATS } from "../lib/site";
import dakApp from "../assets/dak-app.png";

const providers = [
  { name: "Codex", by: "OpenAI" },
  { name: "Claude Code", by: "Anthropic" },
  { name: "Cursor", by: "Anysphere" },
  { name: "Grok", by: "xAI" },
  { name: "OpenCode", by: "Open source" },
  { name: "Antigravity", by: "Google" },
];

const panes = [
  {
    id: "threads",
    title: "Threads",
    body: "One list, every agent. Codex can be refactoring while Claude reviews and Grok reads a thread you left overnight. Switch between them without switching apps.",
  },
  {
    id: "canvas",
    title: "Canvas",
    body: "A surface inside the same window. Draw the shape you want, then hand the frame to a thread and let an agent build it.",
  },
  {
    id: "review",
    title: "Review",
    body: "Every turn ends in a checkpoint: a hidden git ref. Read the diff, keep the change, or restore the branch and go again.",
  },
];

const steps = [
  { title: "Install", body: "The desktop app, or straight from the terminal." },
  { title: "Connect", body: "Point DAK at the agents already on your machine." },
  { title: "Work", body: "Threads, checkpoints and a canvas, reachable from any device." },
];
---

<Layout pageClass="page--app">
  <div class="app">
    <header class="topbar">
      <span class="topbar-name">DAK</span>
      <nav class="topnav" aria-label="Sections">
        <a class="topnav-link is-active" href="#overview">Overview</a>
        <a class="topnav-link" href="#agents">Agents</a>
        <a class="topnav-link" href="#canvas">Canvas</a>
        <a class="topnav-link" href="#install">Install</a>
      </nav>
      <a class="btn btn--sm" href="/download">Get DAK</a>
    </header>

    <main class="pane">
      <!-- Hero -->
      <section class="hero" id="overview">
        <h2 class="display" data-in>
          One window for<br />every agent.
        </h2>
        <p class="lead" data-in style="--d:70ms">
          Bring your own subscriptions. DAK hosts the coding agents you already pay
          for, side by side, with threads, checkpoints and a canvas in the same place.
        </p>

        <div class="actions" data-in style="--d:140ms">
          <a id="download-btn" href={RELEASES_URL} class="btn btn--lg">
            <span id="download-label">Get DAK</span>
          </a>
          <button class="copy" id="copy-btn" type="button">
            <code id="install-cmd">npx dak@latest</code>
            <span class="copy-label" id="copy-label">Copy</span>
          </button>
        </div>

        <!-- A turn, drawn left to right so it reads as a pipeline -->
        <div class="run" data-in style="--d:210ms" aria-hidden="true">
          <p class="run-head">
            <span class="run-live"></span>
            <span>Working</span>
            <span class="run-count" id="run-count">1 of 4</span>
          </p>
          <div class="run-rail" id="run-steps">
            <div class="run-node is-active"><span class="run-dot"></span><span class="run-label">Read the repo</span></div>
            <span class="run-link"></span>
            <div class="run-node"><span class="run-dot"></span><span class="run-label">Plan the change</span></div>
            <span class="run-link"></span>
            <div class="run-node"><span class="run-dot"></span><span class="run-label">Edit files</span></div>
            <span class="run-link"></span>
            <div class="run-node"><span class="run-dot"></span><span class="run-label">Capture checkpoint</span></div>
          </div>
        </div>

        <figure class="shot" data-in style="--d:280ms">
          <Image
            src={dakApp}
            alt="DAK: a thread with an agent on the left and the design canvas on the right, in one window"
            format="webp"
            quality={84}
            sizes="(max-width: 860px) 94vw, 1180px"
          />
        </figure>
      </section>

      <!-- Agents -->
      <section class="sec" id="agents">
        <div class="sec-head">
          <h3 class="sec-title" data-in>Runs the agents you already pay for</h3>
          <p class="sec-lead" data-in style="--d:60ms">
            No key to paste, nothing re-billed. Point DAK at the CLIs on your machine
            and they show up as threads.
          </p>
        </div>
        <ul class="tiles" data-in style="--d:120ms">
          {
            providers.map((p) => (
              <li class="tile">
                <span class="tile-mark" aria-hidden="true">{p.name.charAt(0)}</span>
                <span class="tile-name">{p.name}</span>
                <span class="tile-by">{p.by}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Canvas, on a dark band -->
      <section class="sec" id="canvas">
        <div class="band" data-in>
          <div class="band-inner">
            <h3 class="band-title" data-in>What is in the window</h3>
            <div class="seg" data-seg data-in style="--d:60ms">
              <span class="seg-thumb" aria-hidden="true"></span>
              {
                panes.map((p, i) => (
                  <button class="seg-btn" type="button" data-pane={p.id} aria-selected={i === 0 ? "true" : "false"}>
                    {p.title}
                  </button>
                ))
              }
            </div>
            <div class="pane-body" data-in style="--d:120ms">
              {
                panes.map((p, i) => (
                  <p class="pane-text" data-pane-body={p.id} hidden={i !== 0}>
                    {p.body}
                  </p>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- Install -->
      <section class="sec" id="install">
        <div class="sec-head sec-head--center">
          <h3 class="sec-title" data-in>One command</h3>
          <p class="sec-lead" data-in style="--d:60ms">
            No account, no key exchange. The terminal is the whole onboarding.
          </p>
        </div>

        <div class="term" data-in style="--d:120ms" aria-hidden="true">
          <div class="term-bar">
            <span class="term-name">install</span>
          </div>
          <p class="term-line">
            <span class="term-prompt">$</span>
            <span id="typed"></span><span class="caret"></span>
          </p>
        </div>

        <ol class="steps" data-in style="--d:180ms">
          {
            steps.map((s) => (
              <li class="step">
                <b>{s.title}</b>
                <span>{s.body}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Close -->
      <section class="close">
        <p class="close-line" data-in>
          Open source. Your agents. One window.
        </p>
        <div class="actions" data-in style="--d:80ms">
          <a id="download-btn-2" href={RELEASES_URL} class="btn btn--lg">
            <span id="download-label-2">Get DAK</span>
          </a>
          <a class="quiet" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">
            {MARKETING_STATS.users} people already use it
          </a>
        </div>
      </section>

      <footer class="foot">
        <span>&copy; {new Date().getFullYear()} DAK</span>
        <span class="foot-links">
          <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">GitHub</a>
          <a href="/download">Download</a>
          <a href="/legal">Legal</a>
        </span>
      </footer>
    </main>
  </div>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, type ReleaseAsset } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Get DAK for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Get DAK for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Get DAK for Linux" };
    return null;
  }

  // Macs always get the arm64 build. Browsers cannot reliably tell Apple Silicon
  // from Intel (the UA lies, GPU strings lie), and a wrong guess hands an Apple
  // Silicon user a broken app. Intel users pick their build on /download.
  // Do NOT add arch detection back here.
  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((a) => a.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      return assets.find((a) => a.name.endsWith("-arm64.dmg"))?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((a) => a.name.endsWith("-x86_64.AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  async function initDownload() {
    const platform = detectPlatform();
    if (!platform) return;
    document.documentElement.dataset.platform = platform.os;
    for (const [btnId, labelId] of [
      ["download-btn", "download-label"],
      ["download-btn-2", "download-label-2"],
    ] as const) {
      const btn = document.getElementById(btnId) as HTMLAnchorElement | null;
      const label = document.getElementById(labelId);
      if (label) label.textContent = platform.label;
      if (!btn) continue;
      try {
        const release = await fetchLatestRelease();
        const url = pickAsset(release.assets ?? [], platform);
        if (url) {
          btn.href = url;
          btn.removeAttribute("target");
          btn.removeAttribute("rel");
        }
      } catch {
        btn.href = RELEASES_URL;
      }
    }
  }
  initDownload();

  // Copy the install command.
  const copyBtn = document.getElementById("copy-btn");
  const cmdEl = document.getElementById("install-cmd");
  const copyLabel = document.getElementById("copy-label");
  if (copyBtn && cmdEl && copyLabel) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(cmdEl.textContent?.trim() ?? "npx dak@latest");
        copyLabel.textContent = "Copied";
      } catch {
        copyLabel.textContent = "Press Cmd+C";
      }
      setTimeout(() => {
        copyLabel.textContent = "Copy";
      }, 1600);
    });
  }

  // Sections enter once, on the way in.
  const rising = document.querySelectorAll("[data-in]");
  if (rising.length > 0 && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
    );
    rising.forEach((el) => io.observe(el));
  } else {
    rising.forEach((el) => el.classList.add("is-in"));
  }

  // The top nav marks the section you are reading.
  const navItems = Array.from(document.querySelectorAll<HTMLAnchorElement>(".topnav-link"));
  if (navItems.length > 0 && "IntersectionObserver" in window) {
    const setActive = (id: string) => {
      navItems.forEach((item) =>
        item.classList.toggle("is-active", item.getAttribute("href") === `#${id}`)
      );
    };
    const sections = navItems
      .map((i) => document.querySelector<HTMLElement>(i.getAttribute("href") ?? ""))
      .filter((s): s is HTMLElement => Boolean(s));
    const spy = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible[0]?.target.id) setActive(visible[0].target.id);
      },
      { rootMargin: "-25% 0px -55% 0px", threshold: [0.01, 0.25, 0.6] }
    );
    sections.forEach((s) => spy.observe(s));
  }

  // The pipeline walks a turn step by step. It is the one thing on the page
  // that moves unprompted, so the product reads as working, not as a brochure.
  const rail = document.getElementById("run-steps");
  const runCount = document.getElementById("run-count");
  if (rail && runCount && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const nodes = Array.from(rail.querySelectorAll<HTMLElement>(".run-node"));
    let at = 0;
    const paint = () => {
      nodes.forEach((node, i) => {
        node.classList.toggle("is-done", i < at);
        node.classList.toggle("is-active", i === at);
      });
      runCount.textContent = `${at + 1} of ${nodes.length}`;
    };
    paint();
    setInterval(() => {
      at = (at + 1) % nodes.length;
      paint();
    }, 2400);
  }

  // The segmented control slides its thumb and swaps the pane.
  const seg = document.querySelector<HTMLElement>("[data-seg]");
  if (seg) {
    const thumb = seg.querySelector<HTMLElement>(".seg-thumb");
    const buttons = Array.from(seg.querySelectorAll<HTMLButtonElement>(".seg-btn"));
    const bodies = Array.from(document.querySelectorAll<HTMLElement>("[data-pane-body]"));
    const select = (btn: HTMLElement) => {
      buttons.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
      bodies.forEach((b) => {
        b.hidden = b.dataset.paneBody !== btn.dataset.pane;
      });
      if (thumb) {
        thumb.style.width = `${btn.offsetWidth}px`;
        thumb.style.transform = `translateX(${btn.offsetLeft}px)`;
      }
    };
    buttons.forEach((btn) => btn.addEventListener("click", () => select(btn)));
    requestAnimationFrame(() => select(buttons[0]));
    window.addEventListener("resize", () => {
      const active = buttons.find((b) => b.getAttribute("aria-selected") === "true");
      if (active) select(active);
    });
  }

  // The terminal types the install command once, when it comes into view.
  const typed = document.getElementById("typed");
  if (typed) {
    const command = "npx dak@latest";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      typed.textContent = command;
    } else {
      let started = false;
      const run = () => {
        if (started) return;
        started = true;
        let i = 0;
        const step = () => {
          typed.textContent = command.slice(0, ++i);
          if (i < command.length) setTimeout(step, 70);
        };
        setTimeout(step, 260);
      };
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            run();
            io.disconnect();
          }
        });
        const term = document.querySelector(".term");
        if (term) io.observe(term);
      } else {
        run();
      }
    }
  }
</script>

<style>
  :global(.page--app) {
    --desk: #e6ebf2;
    --pane: #f4f7fb;
    --card: #ffffff;
    --night: #0f1319;
    --chrome: rgba(244, 247, 251, 0.82);
    --line: rgba(21, 32, 51, 0.09);
    --line-2: rgba(21, 32, 51, 0.15);
    --ink: #141922;
    --ink-2: #454d5c;
    --ink-3: #5c6675;
    --blue: #0b63d6;
    --blue-deep: #084da8;
    --ctl-r: 7px;
    --ui: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--desk);
    color: var(--ink);
    font-family: var(--ui);
    position: relative;
  }

  /* One cool wash behind the whole page, so the translucent bar has
     something to sit on. */
  :global(.page--app)::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(1200px 720px at 50% -18%, rgb(11 99 214 / 12%), transparent 68%);
  }

  .app {
    position: relative;
    z-index: 1;
    min-height: 100svh;
  }

  /* ── Top bar ──────────────────────────────────────────── */
  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 54px;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 0 clamp(16px, 4vw, 40px);
    background: var(--chrome);
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    border-bottom: 1px solid var(--line);
  }

  .topbar-name {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* The nav is centred on the viewport, not on the gap the brand and the
     button leave behind, so it does not drift as the button label changes. */
  .topnav {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .topnav-link {
    padding: 6px 11px;
    border-radius: var(--ctl-r);
    font-size: 13px;
    color: var(--ink-2);
    transition: color 0.18s ease, background 0.18s ease;
  }

  .topnav-link:hover { background: rgb(11 99 214 / 8%); color: var(--ink); }

  .topnav-link.is-active {
    background: rgb(11 99 214 / 12%);
    color: var(--blue);
    font-weight: 500;
  }

  .topbar .btn { margin-left: auto; }

  /* ── Pane ─────────────────────────────────────────────── */
  .pane {
    width: 100%;
    max-width: 1240px;
    margin: 54px auto 0;
    padding: 0 clamp(20px, 5vw, 56px);
  }

  /* ── Hero, centered ───────────────────────────────────── */
  .hero {
    text-align: center;
    padding-top: clamp(56px, 9vh, 100px);
  }

  .display {
    font-family: var(--font-sans);
    font-size: clamp(44px, 7.4vw, 96px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.92;
    margin: 0 auto;
  }

  .lead {
    margin: 22px auto 0;
    max-width: 47ch;
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    padding: 0 16px;
    border-radius: var(--ctl-r);
    background: var(--blue);
    color: #fff;
    font-family: var(--ui);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    transition: background 0.16s ease, transform 0.16s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .btn:hover { background: var(--blue-deep); }
  .btn:active { transform: scale(0.975); }

  .btn--lg { height: 42px; padding: 0 22px; font-size: 16px; }

  .copy {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 42px;
    padding: 0 15px;
    border: 1px solid var(--line-2);
    border-radius: var(--ctl-r);
    background: rgb(255 255 255 / 82%);
    transition: background 0.16s ease, transform 0.16s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .copy:hover { background: #fff; }
  .copy:active { transform: scale(0.985); }

  .copy code {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink);
  }

  .copy-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-3);
  }

  /* ── The pipeline ─────────────────────────────────────── */
  .run {
    margin: 40px auto 0;
    max-width: 780px;
  }

  .run-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
  }

  .run-live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue);
    animation: run-pulse 1.6s ease-in-out infinite;
  }

  .run-count {
    color: var(--ink-3);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .run-rail {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
  }

  .run-node {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }

  .run-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex: none;
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--line-2);
    transition: background 0.4s ease, box-shadow 0.4s ease;
  }

  .run-label {
    font-size: 13px;
    color: var(--ink-3);
    white-space: nowrap;
    transition: color 0.4s ease;
  }

  .run-node.is-done .run-dot {
    background: var(--ink-3);
    box-shadow: inset 0 0 0 1.5px var(--ink-3);
  }

  .run-node.is-done .run-label { color: var(--ink-2); }

  .run-node.is-active .run-dot {
    background: var(--blue);
    box-shadow: inset 0 0 0 1.5px var(--blue);
  }

  .run-node.is-active .run-label {
    color: var(--ink);
    font-weight: 500;
  }

  .run-link {
    flex: 1 1 auto;
    min-width: 10px;
    height: 1.5px;
    background: var(--line-2);
    transition: background 0.4s ease;
  }

  .run-node.is-done + .run-link { background: var(--blue); }

  @keyframes run-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.72); }
  }

  /* ── The one image ────────────────────────────────────── */
  .shot {
    position: relative;
    margin: clamp(40px, 6vw, 68px) auto 0;
    max-width: 1120px;
    border-radius: 16px;
    background: #0d1117;
    padding: 7px;
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 18%),
      0 2px 4px rgb(12 24 48 / 10%),
      0 46px 90px -34px rgb(12 30 62 / 46%);
  }

  .shot > :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  /* The shot unfolds from a tilt, so the hero has one real gesture. */
  :global(.js) .shot[data-in] {
    opacity: 0;
    transform: perspective(1800px) rotateX(7deg) translateY(30px) scale(0.975);
    transition:
      opacity 0.9s cubic-bezier(0.32, 0.72, 0, 1) var(--d, 0ms),
      transform 0.9s cubic-bezier(0.32, 0.72, 0, 1) var(--d, 0ms);
  }

  :global(.js) .shot[data-in].is-in {
    opacity: 1;
    transform: perspective(1800px) rotateX(0deg) translateY(0) scale(1);
  }

  /* ── Sections ─────────────────────────────────────────── */
  .sec {
    padding-top: clamp(72px, 11vw, 132px);
    scroll-margin-top: 72px;
  }

  /* Title left, argument right: the header carries the asymmetry so the
     section does not read as another left-aligned block. */
  .sec-head {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 56px);
    align-items: end;
  }

  .sec-head--center {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }

  .sec-title {
    font-family: var(--font-sans);
