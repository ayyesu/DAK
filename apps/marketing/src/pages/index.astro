---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
import {
  CONTRIBUTING_URL,
  GITHUB_ISSUES_URL,
  GITHUB_NEW_ISSUE_URL,
  GITHUB_REPOSITORY_URL,
  LICENSE_URL,
  PROVIDER_SETUP_URL,
} from "../lib/site";
import dakApp from "../assets/dak-app.png";

const providers = [
  { name: "Codex", by: "OpenAI", logo: "/harnesses/openai_dark.svg" },
  { name: "Claude Code", by: "Anthropic", logo: "/harnesses/claude-ai-icon.svg" },
  { name: "Cursor", by: "Anysphere", logo: "/harnesses/cursor_light.svg" },
  { name: "Grok", by: "xAI", logo: "/harnesses/grok-dark.svg" },
  { name: "OpenCode", by: "SST", logo: "/harnesses/opencode-dark.svg" },
  { name: "Antigravity", by: "Google", logo: "/harnesses/antigravity.svg" },
];

const facts = [
  { value: "MIT", label: "open source license" },
  { value: "6", label: "agent providers" },
  { value: "Free", label: "to download" },
];

const features = [
  {
    index: "01",
    title: "Threads, not tabs",
    body: "Keep one thread list per project. Run Codex, Claude, and Cursor at the same time and switch without losing context.",
  },
  {
    index: "02",
    title: "A worktree per thread",
    body: "Give parallel agents their own git worktree, so two turns do not edit the same files.",
  },
  {
    index: "03",
    title: "A checkpoint every turn",
    body: "Each turn ends in a hidden git ref. Read the diff, keep the change, or restore the branch.",
  },
  {
    index: "04",
    title: "Review before you apply",
    body: "See file changes and command output in the thread. Permission modes control what runs without asking.",
  },
  {
    index: "05",
    title: "A terminal in the same window",
    body: "Run the project scripts next to the agent that changed them.",
  },
  {
    index: "06",
    title: "Remote when you leave",
    body: "Open the same environment from the web app or the iOS and Android apps. Agents keep running on your computer.",
  },
];

const steps = [
  { title: "Install", body: "Use the desktop build for macOS, Windows, or Linux, or run the server from a terminal." },
  { title: "Connect", body: "Sign in to the agent providers you already use. DAK lists them when you start a thread." },
  { title: "Work", body: "Open a project, start a thread, and review the checkpoint when the turn ends." },
];

const contribute = [
  {
    title: "Read the source",
    body: "Browse the server, web, desktop, and mobile apps in one repository.",
    href: GITHUB_REPOSITORY_URL,
  },
  {
    title: "Report a bug",
    body: "Open an issue with reproduction steps and the environment you used.",
    href: GITHUB_NEW_ISSUE_URL,
  },
  {
    title: "Propose a change",
    body: "Large changes need an agreed direction first. Read the approval rules in the contributing guide.",
    href: `${CONTRIBUTING_URL}#establish-the-problem-and-scope-first`,
  },
  {
    title: "Contributing guide",
    body: "Read the scope, approval, and verification rules before you open a pull request.",
    href: CONTRIBUTING_URL,
  },
];
---

<Layout
  pageClass="page--app"
  title="DAK · One window for every coding agent"
  description="DAK is a free, open source desktop app for running Codex, Claude Code, Cursor, Grok, OpenCode, and Antigravity in one window."
>
  <div class="app">
    <header class="topbar">
      <span class="topbar-name">DAK</span>
      <nav class="topnav" aria-label="Sections">
        <a class="topnav-link" href="#features">Features</a>
        <a class="topnav-link" href="#providers">Providers</a>
        <a class="topnav-link" href="#open-source">Open source</a>
        <a class="topnav-link" href="#install">Install</a>
      </nav>
      <a class="btn btn--sm" href="/download">Get DAK</a>
    </header>

    <main class="pane">
      <!-- Hero -->
      <section class="hero" id="overview">
        <p class="eyebrow" data-in>Open source · MIT licensed</p>
        <h1 class="display" data-in style="--d:40ms">
          One window for<br />every agent.
        </h1>
        <p class="lead" data-in style="--d:90ms">
          DAK is a free, open source desktop app that runs the coding agents you
          already use. Keep your subscriptions. Get threads, worktrees,
          checkpoints, and a canvas in one place.
        </p>

        <div class="actions" data-in style="--d:140ms">
          <a id="download-btn" href={RELEASES_URL} class="btn btn--lg">
            <span id="download-label">Get DAK</span>
          </a>
          <button class="copy" id="copy-btn" type="button">
            <code id="install-cmd">curl -fsSL https://dak.codes/install.sh | sh</code>
            <span class="copy-label" id="copy-label">Copy</span>
          </button>
        </div>

        <ul class="facts" data-in style="--d:190ms" aria-label="DAK at a glance">
          {
            facts.map((fact) => (
              <li>
                <b>{fact.value}</b>
                <span>{fact.label}</span>
              </li>
            ))
          }
        </ul>

        <!-- A turn, drawn left to right so it reads as a pipeline -->
        <div class="run" data-in style="--d:240ms" aria-hidden="true">
          <p class="run-head">
            <span class="run-live"></span>
            <span>Working</span>
            <span class="run-count" id="run-count">1 of 4</span>
          </p>
          <div class="run-rail" id="run-steps">
            <div class="run-node is-active"><span class="run-dot"></span><span class="run-label">Read the repo</span></div>
            <span class="run-link"></span>
            <div class="run-node"><span class="run-dot"></span><span class="run-label">Plan the change</span></div>
            <span class="run-link"></span>
            <div class="run-node"><span class="run-dot"></span><span class="run-label">Edit files</span></div>
            <span class="run-link"></span>
            <div class="run-node"><span class="run-dot"></span><span class="run-label">Capture checkpoint</span></div>
          </div>
        </div>

        <figure class="shot" data-in style="--d:300ms">
          <Image
            src={dakApp}
            alt="DAK: a thread with an agent on the left and the design canvas on the right, in one window"
            format="webp"
            quality={84}
            sizes="(max-width: 860px) 94vw, 1180px"
          />
        </figure>
      </section>

      <!-- What ships today -->
      <section class="sec" id="features">
        <div class="sec-head">
          <h2 class="sec-title" data-in>Built for work you can review.</h2>
          <p class="sec-lead" data-in style="--d:60ms">
            Every feature below ships in the app today. The source is public,
            so you can check for yourself.
          </p>
        </div>

        <ul class="features" data-in style="--d:120ms">
          {
            features.map((feature) => (
              <li class="feature">
                <span class="feature-index">{feature.index}</span>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </li>
            ))
          }
        </ul>

        <div class="canvas-card" data-in style="--d:180ms">
          <div class="canvas-copy">
            <span class="feature-index">07</span>
            <h3>Canvas</h3>
            <p>
              Agents put pages and mockups on a canvas as frames. Pan, zoom, and
              read the design beside the thread that made it.
            </p>
          </div>
          <div class="canvas-mock" aria-hidden="true">
            <div class="canvas-toolbar"><span></span><span></span><span></span></div>
            <div class="canvas-stage">
              <span class="canvas-frame"><span>Frame 01</span></span>
              <span class="canvas-cursor"></span>
            </div>
          </div>
        </div>
      </section>

      <!-- Providers -->
      <section class="sec" id="providers">
        <div class="band band--providers" data-in>
          <div class="band-head">
            <h2 class="band-title">Bring the agents you already use.</h2>
            <p class="band-lead">
              DAK does not resell models or keys. It connects to the agent tools
              you already use, under your existing subscriptions.
            </p>
          </div>

          <ul class="provider-grid">
            {
              providers.map((provider) => (
                <li class="provider">
                  <span class="provider-logo">
                    <img
                      src={provider.logo}
                      alt=""
                      width="28"
                      height="28"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="provider-copy">
                    <b>{provider.name}</b>
                    <span>{provider.by}</span>
                  </span>
                </li>
              ))
            }
          </ul>

          <p class="band-note">
            Install and sign in to at least one provider before you start.
            Settings also lists Muse Code, Pi, and the ACP Registry for adding
            other agents.{" "}
            <a href={PROVIDER_SETUP_URL} target="_blank" rel="noreferrer">
              Provider setup
            </a>
          </p>
        </div>
      </section>

      <!-- Install -->
      <section class="sec" id="install">
        <div class="sec-head sec-head--center">
          <h2 class="sec-title" data-in>Three steps, no account required.</h2>
          <p class="sec-lead" data-in style="--d:60ms">
            Local use does not need a DAK account. Install the app or run the
            server from a terminal.
          </p>
        </div>

        <div class="term" data-in style="--d:120ms" aria-hidden="true">
          <div class="term-bar">
            <span class="term-name">install</span>
          </div>
          <p class="term-line">
            <span class="term-prompt">$</span>
            <span id="typed"></span><span class="caret"></span>
          </p>
        </div>

        <p class="term-note" data-in style="--d:140ms">
          On Windows, run <code>irm https://dak.codes/install.ps1 | iex</code> in PowerShell.
        </p>

        <ol class="steps" data-in style="--d:180ms">
          {
            steps.map((step) => (
              <li class="step">
                <b>{step.title}</b>
                <span>{step.body}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Open source -->
      <section class="sec" id="open-source">
        <div class="band band--source" data-in>
          <div class="source-head">
            <span class="source-badge">MIT</span>
            <h2 class="band-title">Open source, all the way down.</h2>
            <p class="band-lead">
              The server, clients, and provider adapters are in one public
              repository. Read the code before you trust it.
            </p>
            <a class="source-license" href={LICENSE_URL} target="_blank" rel="noreferrer">
              Read the license <span aria-hidden="true">↗</span>
            </a>
          </div>

          <ul class="source-links">
            {
              contribute.map((item) => (
                <li>
                  <a href={item.href} target="_blank" rel="noreferrer">
                    <span class="source-link-title">{item.title}</span>
                    <span class="source-link-body">{item.body}</span>
                    <span class="source-arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))
            }
          </ul>

          <p class="band-note">
            Focused bug fixes, reliability fixes, and performance work are the
            most likely to be accepted. A new feature needs an agreed direction
            before the work starts.{" "}
            <a href={GITHUB_ISSUES_URL} target="_blank" rel="noreferrer">
              Browse open issues
            </a>
          </p>
        </div>
      </section>

      <!-- Download -->
      <section class="sec" id="download">
        <div class="sec-head">
          <h2 class="sec-title" data-in>Get DAK.</h2>
          <p class="sec-lead" data-in style="--d:60ms">
            Free to download. Your provider subscriptions stay yours.
          </p>
        </div>

        <div class="platforms" data-in style="--d:120ms">
          <a class="platform" href="/download">
            <span class="platform-os">macOS</span>
            <span class="platform-detail">Apple Silicon and Intel</span>
            <span class="platform-arrow" aria-hidden="true">→</span>
          </a>
          <a class="platform" href="/download">
            <span class="platform-os">Windows</span>
            <span class="platform-detail">Windows 10 and 11, x64</span>
            <span class="platform-arrow" aria-hidden="true">→</span>
          </a>
          <a class="platform" href="/download">
            <span class="platform-os">Linux</span>
            <span class="platform-detail">Debian, Ubuntu, AppImage</span>
            <span class="platform-arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <p class="platform-note" data-in style="--d:160ms">
          Prefer a terminal? <code>curl -fsSL https://dak.codes/install.sh | sh</code> or{" "}
          <a href="/download">see every install option</a>.
        </p>
      </section>

      <!-- Close -->
      <section class="close">
        <p class="close-line" data-in>
          Your agents. Your machine. Your window.
        </p>
        <div class="actions" data-in style="--d:80ms">
          <a id="download-btn-2" href={RELEASES_URL} class="btn btn--lg">
            <span id="download-label-2">Get DAK</span>
          </a>
          <a class="quiet" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">
            Read the source
          </a>
        </div>
      </section>

      <footer class="foot">
        <span>&copy; {new Date().getFullYear()} DAK</span>
        <span class="foot-links">
          <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">GitHub</a>
          <a href={GITHUB_ISSUES_URL} target="_blank" rel="noreferrer">Issues</a>
          <a href={CONTRIBUTING_URL} target="_blank" rel="noreferrer">Contribute</a>
          <a href="/download">Download</a>
          <a href="/legal">Legal</a>
        </span>
      </footer>
    </main>
  </div>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, type ReleaseAsset } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Get DAK for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Get DAK for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Get DAK for Linux" };
    return null;
  }

  // Macs always get the arm64 build. Browsers cannot reliably tell Apple Silicon
  // from Intel (the UA lies, GPU strings lie), and a wrong guess hands an Apple
  // Silicon user a broken app. Intel users pick their build on /download.
  // Do NOT add arch detection back here.
  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((a) => a.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      return assets.find((a) => a.name.endsWith("-arm64.dmg"))?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((a) => a.name.endsWith("-x86_64.AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  async function initDownload() {
    const platform = detectPlatform();
    if (!platform) return;
    document.documentElement.dataset.platform = platform.os;
    for (const [btnId, labelId] of [
      ["download-btn", "download-label"],
      ["download-btn-2", "download-label-2"],
    ] as const) {
      const btn = document.getElementById(btnId) as HTMLAnchorElement | null;
      const label = document.getElementById(labelId);
      if (label) label.textContent = platform.label;
      if (!btn) continue;
      try {
        const release = await fetchLatestRelease();
        const url = pickAsset(release.assets ?? [], platform);
        if (url) {
          btn.href = url;
          btn.removeAttribute("target");
          btn.removeAttribute("rel");
        }
      } catch {
        btn.href = RELEASES_URL;
      }
    }
  }
  initDownload();

  // Copy the install command.
  const copyBtn = document.getElementById("copy-btn");
  const cmdEl = document.getElementById("install-cmd");
  const copyLabel = document.getElementById("copy-label");
  if (copyBtn && cmdEl && copyLabel) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(cmdEl.textContent?.trim() ?? "");
        copyLabel.textContent = "Copied";
      } catch {
        copyLabel.textContent = navigator.userAgent.includes("Mac") ? "Press Cmd+C" : "Press Ctrl+C";
      }
      setTimeout(() => {
        copyLabel.textContent = "Copy";
      }, 1600);
    });
  }

  // Sections enter once, on the way in.
  const rising = document.querySelectorAll("[data-in]");
  if (rising.length > 0 && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
    );
    rising.forEach((el) => io.observe(el));
  } else {
    rising.forEach((el) => el.classList.add("is-in"));
  }

  // The top nav marks the section you are reading.
  const navItems = Array.from(document.querySelectorAll<HTMLAnchorElement>(".topnav-link"));
  if (navItems.length > 0 && "IntersectionObserver" in window) {
    const setActive = (id: string) => {
      navItems.forEach((item) =>
        item.classList.toggle("is-active", item.getAttribute("href") === `#${id}`)
      );
    };
    const sections = navItems
      .map((i) => document.querySelector<HTMLElement>(i.getAttribute("href") ?? ""))
      .filter((s): s is HTMLElement => Boolean(s));
    const spy = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible[0]?.target.id) setActive(visible[0].target.id);
      },
      { rootMargin: "-25% 0px -55% 0px", threshold: [0.01, 0.25, 0.6] }
    );
    sections.forEach((s) => spy.observe(s));
  }

  // The pipeline walks a turn step by step. It is the one thing on the page
  // that moves unprompted, so the product reads as working, not as a brochure.
  const rail = document.getElementById("run-steps");
  const runCount = document.getElementById("run-count");
  if (rail && runCount && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const nodes = Array.from(rail.querySelectorAll<HTMLElement>(".run-node"));
    let at = 0;
    const paint = () => {
      nodes.forEach((node, i) => {
        node.classList.toggle("is-done", i < at);
        node.classList.toggle("is-active", i === at);
      });
      runCount.textContent = `${at + 1} of ${nodes.length}`;
    };
    paint();
    setInterval(() => {
      at = (at + 1) % nodes.length;
      paint();
    }, 2400);
  }

  // The terminal types the install command once, when it comes into view.
  const typed = document.getElementById("typed");
  if (typed) {
    const command = "curl -fsSL https://dak.codes/install.sh | sh";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      typed.textContent = command;
    } else {
      let started = false;
      const run = () => {
        if (started) return;
        started = true;
        let i = 0;
        const step = () => {
          typed.textContent = command.slice(0, ++i);
          if (i < command.length) setTimeout(step, 70);
        };
        setTimeout(step, 260);
      };
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            run();
            io.disconnect();
          }
        });
        const term = document.querySelector(".term");
        if (term) io.observe(term);
      } else {
        run();
      }
    }
  }
</script>

<style>
  :global(.page--app) {
    --desk: #e6ebf2;
    --pane: #f4f7fb;
    --card: #ffffff;
    --night: #0f1319;
    --chrome: rgba(244, 247, 251, 0.82);
    --line: rgba(21, 32, 51, 0.09);
    --line-2: rgba(21, 32, 51, 0.15);
    --ink: #141922;
    --ink-2: #454d5c;
    --ink-3: #5c6675;
    --blue: #0b63d6;
    --blue-deep: #084da8;
    --ctl-r: 7px;
    --ui: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--desk);
    color: var(--ink);
    font-family: var(--ui);
    position: relative;
  }

  /* One cool wash behind the whole page, so the translucent bar has
     something to sit on. */
  :global(.page--app)::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(1200px 720px at 50% -18%, rgb(11 99 214 / 12%), transparent 68%);
  }

  .app {
    position: relative;
    z-index: 1;
    min-height: 100svh;
  }

  /* ── Top bar ──────────────────────────────────────────── */
  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 54px;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 0 clamp(16px, 4vw, 40px);
    background: var(--chrome);
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    border-bottom: 1px solid var(--line);
  }

  .topbar-name {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* The nav is centred on the viewport, not on the gap the brand and the
     button leave behind, so it does not drift as the button label changes. */
  .topnav {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .topnav-link {
    padding: 6px 11px;
    border-radius: var(--ctl-r);
    font-size: 13px;
    color: var(--ink-2);
    transition: color 0.18s ease, background 0.18s ease;
  }

  .topnav-link:hover { background: rgb(11 99 214 / 8%); color: var(--ink); }

  .topnav-link.is-active {
    background: rgb(11 99 214 / 12%);
    color: var(--blue);
    font-weight: 500;
  }

  .topbar .btn { margin-left: auto; }

  /* ── Pane ─────────────────────────────────────────────── */
  .pane {
    width: 100%;
    max-width: 1240px;
    margin: 54px auto 0;
    padding: 0 clamp(20px, 5vw, 56px);
  }

  /* ── Hero, centered ───────────────────────────────────── */
  .hero {
    text-align: center;
    padding-top: clamp(56px, 9vh, 100px);
  }

  .display {
    margin: 18px auto 0;
    font-family: var(--font-sans);
    font-size: clamp(44px, 7.4vw, 96px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.92;
  }

  .lead {
    margin: 22px auto 0;
    max-width: 50ch;
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    padding: 0 16px;
    border-radius: var(--ctl-r);
    background: var(--blue);
    color: #fff;
    font-family: var(--ui);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    transition: background 0.16s ease, transform 0.16s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .btn:hover { background: var(--blue-deep); }
  .btn:active { transform: scale(0.975); }

  .btn--lg { height: 42px; padding: 0 22px; font-size: 16px; }

  .copy {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 42px;
    padding: 0 15px;
    border: 1px solid var(--line-2);
    border-radius: var(--ctl-r);
    background: rgb(255 255 255 / 82%);
    transition: background 0.16s ease, transform 0.16s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .copy:hover { background: #fff; }
  .copy:active { transform: scale(0.985); }

  .copy code {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink);
  }

  .copy-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-3);
  }

  /* ── Static facts ─────────────────────────────────────── */
  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 28px;
    margin: 30px auto 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
  }

  .facts b {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .facts span {
    font-size: 13px;
    color: var(--ink-3);
  }

  /* ── The pipeline ─────────────────────────────────────── */
  .run {
    margin: 40px auto 0;
    max-width: 780px;
  }

  .run-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
  }

  .run-live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue);
    animation: run-pulse 1.6s ease-in-out infinite;
  }

  .run-count {
    color: var(--ink-3);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .run-rail {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
  }

  .run-node {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }

  .run-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex: none;
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--line-2);
    transition: background 0.4s ease, box-shadow 0.4s ease;
  }

  .run-label {
    font-size: 13px;
    color: var(--ink-3);
    white-space: nowrap;
    transition: color 0.4s ease;
  }

  .run-node.is-done .run-dot {
    background: var(--ink-3);
    box-shadow: inset 0 0 0 1.5px var(--ink-3);
  }

  .run-node.is-done .run-label { color: var(--ink-2); }

  .run-node.is-active .run-dot {
    background: var(--blue);
    box-shadow: inset 0 0 0 1.5px var(--blue);
  }

  .run-node.is-active .run-label {
    color: var(--ink);
    font-weight: 500;
  }

  .run-link {
    flex: 1 1 auto;
    min-width: 10px;
    height: 1.5px;
    background: var(--line-2);
    transition: background 0.4s ease;
  }

  .run-node.is-done + .run-link { background: var(--blue); }

  @keyframes run-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.72); }
  }

  /* ── The one image ────────────────────────────────────── */
  .shot {
    position: relative;
    margin: clamp(40px, 6vw, 68px) auto 0;
    max-width: 1120px;
    border-radius: 16px;
    background: #0d1117;
    padding: 7px;
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 18%),
      0 2px 4px rgb(12 24 48 / 10%),
      0 46px 90px -34px rgb(12 30 62 / 46%);
  }

  .shot > :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  /* The shot unfolds from a tilt, so the hero has one real gesture. */
  :global(.js) .shot[data-in] {
    opacity: 0;
    transform: perspective(1800px) rotateX(7deg) translateY(30px) scale(0.975);
    transition:
      opacity 0.9s cubic-bezier(0.32, 0.72, 0, 1) var(--d, 0ms),
      transform 0.9s cubic-bezier(0.32, 0.72, 0, 1) var(--d, 0ms);
  }

  :global(.js) .shot[data-in].is-in {
    opacity: 1;
    transform: perspective(1800px) rotateX(0deg) translateY(0) scale(1);
  }

  /* ── Sections ─────────────────────────────────────────── */
  .sec {
    padding-top: clamp(72px, 11vw, 132px);
    scroll-margin-top: 72px;
  }

  /* Title left, argument right: the header carries the asymmetry so the
     section does not read as another left-aligned block. */
  .sec-head {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 56px);
    align-items: end;
  }

  .sec-head--center {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }

  .sec-title {
    font-family: var(--font-sans);
    font-size: clamp(24px, 3.6vw, 44px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .sec-lead {
    margin: 0;
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .sec-head--center .sec-lead { margin-top: 14px; }

  /* ── Feature grid ─────────────────────────────────────── */
  .features {
    margin-top: clamp(26px, 3vw, 40px);
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .feature {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 22px 26px;
    border-radius: 14px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      transform 0.3s cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 0.3s ease;
  }

  .feature:hover {
    transform: translateY(-4px);
    box-shadow: inset 0 0 0 1px var(--line), 0 18px 34px -22px rgb(12 30 62 / 40%);
  }

  .feature-index {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--blue);
  }

  .feature h3,
  .canvas-copy h3 {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .feature p,
  .canvas-copy p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* ── Canvas card ──────────────────────────────────────── */
  .canvas-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(20px, 4vw, 44px);
    align-items: center;
    margin-top: 12px;
    padding: clamp(24px, 3vw, 34px);
    border-radius: 14px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .canvas-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .canvas-mock {
    border-radius: 10px;
    background: var(--night);
    overflow: hidden;
    box-shadow: 0 22px 44px -30px rgb(8 20 44 / 60%);
  }

  .canvas-toolbar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    background: rgb(255 255 255 / 5%);
    box-shadow: inset 0 -1px 0 rgb(255 255 255 / 7%);
  }

  .canvas-toolbar span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(255 255 255 / 22%);
  }

  .canvas-stage {
    position: relative;
    height: 190px;
    background-image: radial-gradient(rgb(255 255 255 / 16%) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  .canvas-frame {
    position: absolute;
    top: 38px;
    left: 12%;
    width: 58%;
    height: 112px;
    border: 1.5px solid #6ea8ff;
    border-radius: 4px;
    background: rgb(110 168 255 / 8%);
  }

  .canvas-frame span {
    position: absolute;
    top: -24px;
    left: -1.5px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: #8fb9ff;
    white-space: nowrap;
  }

  .canvas-frame::before,
  .canvas-frame::after {
    content: "";
    position: absolute;
    width: 7px;
    height: 7px;
    border: 1.5px solid #6ea8ff;
    background: var(--night);
    border-radius: 1px;
  }

  .canvas-frame::before { top: -4px; left: -4px; }
  .canvas-frame::after { right: -4px; bottom: -4px; }

  .canvas-cursor {
    position: absolute;
    right: 20%;
    bottom: 34px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 4px rgb(110 168 255 / 22%);
  }

  /* ── Dark bands ───────────────────────────────────────── */
  .band {
    border-radius: 22px;
    background: var(--night);
    padding: clamp(30px, 5vw, 62px);
    color: #dfe6ef;
    box-shadow: 0 40px 80px -44px rgb(8 20 44 / 70%);
    scroll-margin-top: 72px;
  }

  .band--providers {
    background-image: radial-gradient(760px 380px at 78% -20%, rgb(11 99 214 / 34%), transparent 70%);
  }

  .band--source {
    background-image: radial-gradient(700px 360px at 12% -10%, rgb(11 99 214 / 30%), transparent 72%);
  }

  .band-head {
    max-width: 720px;
  }

  .band-title {
    font-family: var(--font-sans);
    font-size: clamp(24px, 3.6vw, 44px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: #fff;
    margin: 0;
  }

  .band-lead {
    max-width: 58ch;
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.6;
    color: #b9c3d1;
  }

  .band-note {
    margin-top: 26px;
    font-size: 13px;
    line-height: 1.6;
    color: #8d99a9;
  }

  .band-note a {
    color: #dfe6ef;
    text-decoration: underline;
    text-decoration-color: rgb(223 230 239 / 35%);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.18s ease;
  }

  .band-note a:hover { text-decoration-color: #dfe6ef; }

  /* ── Provider grid ────────────────────────────────────── */
  .provider-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: clamp(26px, 3vw, 38px);
    padding: 0;
    list-style: none;
  }

  .provider {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-radius: 10px;
    background: rgb(255 255 255 / 5%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 8%);
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }

  .provider:hover {
    background: rgb(255 255 255 / 8%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 14%);
  }

  .provider-logo {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 9px;
    background: rgb(255 255 255 / 6%);
  }

  .provider-logo img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .provider-copy {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .provider-copy b {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .provider-copy span {
    font-size: 12px;
    color: #8d99a9;
  }

  /* ── Install ──────────────────────────────────────────── */
  .term {
    margin: clamp(28px, 4vw, 44px) auto 0;
    max-width: 560px;
    border-radius: 12px;
    background: var(--night);
    background-image: radial-gradient(520px 220px at 50% -40%, rgb(11 99 214 / 40%), transparent 70%);
    box-shadow: 0 26px 54px -30px rgb(8 20 44 / 62%);
    overflow: hidden;
    text-align: left;
  }

  .term-bar {
    display: flex;
    align-items: center;
    height: 34px;
    padding: 0 14px;
    background: rgb(255 255 255 / 5%);
    box-shadow: inset 0 -1px 0 rgb(255 255 255 / 7%);
  }

  .term-name {
    margin: 0 auto;
    padding-right: 32px;
    font-size: 13px;
    color: #a8a8b0;
  }

  .term-line {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 22px 20px 26px;
    font-family: var(--font-mono);
    font-size: 16px;
    color: #eef2f7;
  }

  .term-prompt { color: #6ee08a; }

  .term-note {
    margin: 14px auto 0;
    max-width: 560px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-3);
  }

  .term-note code {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgb(21 32 51 / 6%);
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .caret {
    display: inline-block;
    width: 8px;
    height: 18px;
    margin-left: 1px;
    background: #eef2f7;
    border-radius: 1px;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .steps {
    margin: clamp(34px, 5vw, 56px) auto 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    max-width: 980px;
    text-align: left;
  }

  .step {
    position: relative;
    display: grid;
    gap: 6px;
    padding-top: 18px;
  }

  .step::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--line-2);
  }

  .step b {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .step span { font-size: 16px; line-height: 1.5; color: var(--ink-2); }

  /* ── Open source ──────────────────────────────────────── */
  .source-head {
    max-width: 640px;
  }

  .source-badge {
    display: inline-flex;
    align-items: center;
    height: 24px;
    margin-bottom: 18px;
    padding: 0 9px;
    border-radius: 5px;
    background: rgb(110 224 138 / 12%);
    color: #6ee08a;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .source-license {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    font-size: 13px;
    color: #dfe6ef;
    text-decoration: underline;
    text-decoration-color: rgb(223 230 239 / 35%);
    text-underline-offset: 3px;
  }

  .source-license:hover { text-decoration-color: #dfe6ef; }

  .source-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: clamp(28px, 4vw, 42px);
    padding: 0;
    list-style: none;
  }

  .source-links a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 5px;
    height: 100%;
    padding: 18px 44px 20px 18px;
    border-radius: 10px;
    background: rgb(255 255 255 / 5%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 8%);
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }

  .source-links a:hover {
    background: rgb(255 255 255 / 8%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 14%);
  }

  .source-link-title {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .source-link-body {
    font-size: 13px;
    line-height: 1.5;
    color: #8d99a9;
  }

  .source-arrow {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 14px;
    color: #8d99a9;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .source-links a:hover .source-arrow {
    color: #fff;
    transform: translate(2px, -2px);
  }

  /* ── Download ─────────────────────────────────────────── */
  .platforms {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: clamp(26px, 3vw, 40px);
  }

  .platform {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 12px;
    align-items: center;
    padding: 20px 22px;
    border-radius: 14px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      transform 0.3s cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 0.3s ease;
  }

  .platform:hover {
    transform: translateY(-4px);
    box-shadow: inset 0 0 0 1px var(--line), 0 18px 34px -22px rgb(12 30 62 / 40%);
  }

  .platform-os {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .platform-detail {
    grid-column: 1;
    font-size: 13px;
    color: var(--ink-3);
  }

  .platform-arrow {
    grid-row: 1 / span 2;
    grid-column: 2;
    font-size: 16px;
    color: var(--ink-3);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .platform:hover .platform-arrow {
    color: var(--blue);
    transform: translateX(3px);
  }

  .platform-note {
    margin-top: 20px;
    font-size: 14px;
    color: var(--ink-3);
  }

  .platform-note code {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgb(21 32 51 / 6%);
    color: var(--ink);
  }

  .platform-note a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 3px;
    transition: color 0.18s ease;
  }

  .platform-note a:hover { color: var(--ink); }

  /* ── Close ────────────────────────────────────────────── */
  .close {
    padding: clamp(90px, 16vh, 180px) 0 0;
    text-align: center;
    scroll-margin-top: 72px;
  }

  .close-line {
    max-width: 26ch;
    margin: 0 auto;
    font-family: var(--font-sans);
    font-size: clamp(24px, 3.6vw, 44px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .quiet {
    font-size: 13px;
    color: var(--ink-3);
    transition: color 0.15s ease;
  }

  .quiet:hover { color: var(--ink); }

  .foot {
    margin: clamp(80px, 12vh, 140px) 0 0;
    padding: 24px 0 44px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    box-shadow: inset 0 1px 0 var(--line);
    font-size: 13px;
    color: var(--ink-3);
    text-align: left;
  }

  .foot-links { display: inline-flex; flex-wrap: wrap; gap: 18px; }

  .foot-links a { transition: color 0.15s ease; }
  .foot-links a:hover { color: var(--ink); }

  /* ── Entrances ────────────────────────────────────────── */
  :global(.js) [data-in] {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.66s cubic-bezier(0.32, 0.72, 0, 1) var(--d, 0ms),
      transform 0.66s cubic-bezier(0.32, 0.72, 0, 1) var(--d, 0ms);
  }

  :global(.js) [data-in].is-in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-in],
    :global(.js) .shot[data-in] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .caret { animation: none; }
    .run-live { animation: none; }
    .feature, .platform { transition: none; }
  }

  /* ── Narrow ───────────────────────────────────────────── */
  @media (max-width: 900px) {
    .topnav { display: none; }

    .features { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .provider-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .platforms { grid-template-columns: minmax(0, 1fr); }

    .sec-head {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: 14px;
    }

    .steps { grid-template-columns: minmax(0, 1fr); }

    .canvas-card { grid-template-columns: minmax(0, 1fr); }

    .source-links { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 640px) {
    .display br { display: none; }

    .run-head { justify-content: flex-start; }

    .run-rail {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      margin-top: 14px;
      padding-left: 5px;
    }

    .run-node { gap: 10px; }

    .run-link {
      flex: none;
      width: 1.5px;
      min-width: 0;
      height: 18px;
